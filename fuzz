#!/usr/bin/env bash
# Run the tiffz fuzzing suite (Einstein dispatch outcome 5).
#
# Layers:
#   1. Hermetic deterministic mutation fuzzer (tests/fuzz/fuzz.zig), built
#      ReleaseSafe so any UB on a mutated input is a real bug. Run through the
#      SAME Nix check Mechatron Prime runs (`checks.<system>.fuzz`), so `./fuzz`
#      and CI exercise identical bytes.
#   2. (native) libtiff / ImageMagick oracle diff — added in a follow-up. External
#      tools are dev/test oracles only, kept OUT of the hermetic check so the
#      Mechatron target stays reproducible.
#
# Per CLAUDE.md: NEVER `set -euo pipefail` in test scripts. `set -u` only; the
# runner reports failures and accumulates them into the exit code.

set -u

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

failures=0

run_subtest() {
    local label="$1"
    shift
    printf '\n=== %s ===\n' "$label"
    if "$@"; then
        printf '\n[PASS] %s\n' "$label"
    else
        printf '\n[FAIL] %s\n' "$label"
        failures=$((failures + 1))
    fi
}

# MFIC: bounded coverage must never be silent. Surface exactly what the
# robustness sweep deliberately does NOT mutate, and why, on every run.
# (Keep this echo in lockstep with `robustness_excluded` in tests/fuzz/fuzz.zig.)
printf 'Robustness-sweep exclusions: none — whole corpus mutated.\n'
printf '  (rgb-jpeg.tif was excluded 2026-08-11 → 2026-08-14 for a jpegz decode panic;\n'
printf '   fixed in jpegz d1eedca, re-included at the 919571d pin.)\n'

SYSTEM="$(nix eval --raw --impure --expr 'builtins.currentSystem')"
run_subtest "deterministic mutation fuzzer (ReleaseSafe, sandboxed via nix)" \
    nix build ".#checks.${SYSTEM}.fuzz" --print-out-paths --no-link

if [[ "$failures" -gt 0 ]]; then
    printf '\n%d fuzz suite(s) failed.\n' "$failures" >&2
    exit "$failures"
fi
printf '\nAll fuzz suites passed.\n'

.{
    .name = .tiffz,
    .version = "0.1.0",
    .fingerprint = 0x4373ea0a0149ebaa,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // lzwz — shared strict LZW core for TIFF, PDF, and GIF. tiffz
        // re-exports this exact module so downstream consumers do not create
        // a second Zig module instance for the same source.
        .lzwz = .{
            .url = "git+https://github.com/pmarreck/lzwz#ab21d65c2e6d08f6a6ce2f2c3067f99de689cee7",
            .hash = "lzwz-0.2.0-gkUIt73PAABk11qWDTYUT3CB-7K1bFkGmoW0l_eTEbWw",
        },
        // jpegz — Peter's spec-complete pure-Zig JPEG family decoder
        // (cleanroom replacement target; Phase 1 currently wraps
        // libjpeg-turbo + openjpeg). Provides the codec for
        // Compression=7 (JPEG-in-TIFF) at M9.5 and lossless JPEG for
        // DNG raw at M8.
        .jpegz = .{
            .url = "git+https://github.com/pmarreck/jpegz#cc844e274a057e1bb1fb278ab27cab8da15582b3",
            .hash = "jpegz-0.1.0-staw4EmMCwAp0oMOhErnWNUnGmKUUyHnu2SpiF6KdEbY",
        },
        // zstdz — Peter's fork of facebook/zstd packaged as a Zig
        // build with the C library vendored. Provides the codec for
        // Compression=50000 (ZSTD-in-TIFF, GDAL/libtiff extension).
        .zstdz = .{
            .url = "https://github.com/pmarreck/zstdz/archive/f5a61699f1958c7bc152a417ff86336a6efa4689.tar.gz",
            .hash = "zstdz-1.6.0-yDWjziFdNAAbdfO9bwVKQyiOTmFFNnuIVlFD00msI-t3",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "cli",
        "tests",
    },
}

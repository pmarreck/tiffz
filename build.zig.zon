.{
    .name = .tiffz,
    .version = "0.1.0",
    .fingerprint = 0x4373ea0a0149ebaa,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // jpegz — Peter's spec-complete pure-Zig JPEG family decoder
        // (cleanroom replacement target; Phase 1 currently wraps
        // libjpeg-turbo + openjpeg). Provides the codec for
        // Compression=7 (JPEG-in-TIFF) at M9.5 and lossless JPEG for
        // DNG raw at M8.
        .jpegz = .{
            .url = "git+https://github.com/pmarreck/jpegz#f8dcb8e98f3e00543101f4a2a1668add539afd6f",
            .hash = "jpegz-0.1.0-staw4H4ECgADl_IUt3tUVQWgdChXCqbeRYRZ7vt815UC",
        },
        // zstdz — Peter's fork of facebook/zstd packaged as a Zig
        // build with the C library vendored. Provides the codec for
        // Compression=50000 (ZSTD-in-TIFF, GDAL/libtiff extension).
        .zstdz = .{
            .url = "git+https://github.com/pmarreck/zstdz#f5a61699f1958c7bc152a417ff86336a6efa4689",
            .hash = "zstdz-1.6.0-yDWjzh5cNADGI2Q-tHdBT0IJ1Frqd3Ik6oa4kFnSoLzO",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "cli",
        "tests",
    },
}

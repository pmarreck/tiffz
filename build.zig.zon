.{
    .name = .tiffz,
    .version = "0.1.0",
    .fingerprint = 0x4373ea0a0149ebaa,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // zlib — used for compression=8 (Deflate) and compression=32946
        // (AdobeDeflate, same algorithm). The community Zig wrapper around
        // upstream C zlib (zlib license). Same dep validate uses; matches
        // the project portfolio's zlib posture.
        .zlib = .{
            .url = "https://github.com/allyourcodebase/zlib/archive/refs/heads/main.tar.gz",
            .hash = "zlib-1.3.2-ZZQ7lc8NAAAHm9MDfplvwoesXvk4tVm6VCsiI8KnIbT0",
        },
        // jpegz — Peter's spec-complete pure-Zig JPEG family decoder
        // (cleanroom replacement target; Phase 1 currently wraps
        // libjpeg-turbo + openjpeg). Provides the codec for
        // Compression=7 (JPEG-in-TIFF) at M9.5 and lossless JPEG for
        // DNG raw at M8.
        .jpegz = .{
            .url = "git+https://github.com/pmarreck/jpegz#c36cb174cff4bcc64739d00f030dec4d81843321",
            .hash = "jpegz-0.1.0-staw4LKVCACwNFZlNbPby2iOPn2AIJZSiZ1IenTttyux",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "cli",
        "tests",
    },
}

.{
    .name = .tiffz,
    .version = "0.1.0",
    .fingerprint = 0x4373ea0a0149ebaa,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // lzwz — shared strict LZW core for TIFF, PDF, and GIF. tiffz
        // re-exports this exact module so downstream consumers do not create
        // a second Zig module instance for the same source.
        .lzwz = .{
            .url = "git+https://github.com/pmarreck/lzwz#511bc8f2233d2e69cfeb3671c36d572f2072d3c5",
            .hash = "lzwz-0.3.0-gkUIt0LjAAB5nnuMK3MlylDOJeeEuz673JVL5l_24Kur",
        },
        // jpegz — Peter's spec-complete pure-Zig JPEG family decoder
        // (cleanroom replacement target; Phase 1 currently wraps
        // libjpeg-turbo + openjpeg). Provides the codec for
        // Compression=7 (JPEG-in-TIFF) at M9.5 and lossless JPEG for
        // DNG raw at M8.
        .jpegz = .{
            .url = "git+https://github.com/pmarreck/jpegz#5c5191a1b6fc27aa542f7c15ee70750f6a9e1a60",
            .hash = "jpegz-0.1.0-staw4IzPEgBjqjh6AAsIWM0OdCgaLitbitbHOFR3AtZR",
        },
        // zstdz — Peter's fork of facebook/zstd packaged as a Zig
        // build with the C library vendored. Provides the codec for
        // Compression=50000 (ZSTD-in-TIFF, GDAL/libtiff extension).
        .zstdz = .{
            .url = "https://github.com/pmarreck/zstdz/archive/484cc81791e44d22f459054aedd3ec53dbb20174.tar.gz",
            .hash = "zstdz-1.6.0-yDWjzq-MNAA4J6TsElJhZ6r2bA0csYbReJoPx8NhdL8g",
        },
        // lercz — Peter's Zig-wrap fork of Esri/lerc (Apache-2.0),
        // packaged the same way as zstdz. Provides the codec for
        // Compression=34887 (LERC, GDAL/libtiff extension) with the
        // optional Deflate/Zstd post-filter carried in LercParameters.
        .lercz = .{
            .url = "git+https://github.com/pmarreck/lercz#a88c39b7697e3a579c8a84445a5ca0145bbe59fa",
            .hash = "lercz-4.2.0-y1r8kc2CBgBez9hD_Evo5kg3RH-MaMLLGi3GkOcKFcjz",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "cli",
        "tests",
    },
}

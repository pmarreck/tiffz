# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
depth=3

annotate=[
	CODE_REVIEW.md = 1.0 audit surface (Einstein 2026-07-23 dispatch): measured state, reproducers, root cause, per-fixture attribution, smallest next release slice. Audit-only, no fixes.
	build.zig = Build graph for full tiffz and codec-free tiffz-parser modules, C/Zig artifacts, tests, and shared dependency instances.
	build.zig.zon = Pinned Zig dependencies, including the shared strict lzwz core.
	docs/parser_only_module.md = Consumer wiring and mechanically enforced production-closure contract for tiffz-parser.
	src/compressions/jpeg.zig = TIFF TN2 JPEG stream preparation, exact host-offset mapping, strict validation, and cleanroom decode
	src/compressions/lerc.zig = LERC-in-TIFF (Compression=34887) codec adapter: strict LercParameters parse (codec_version 2..6, add_compression 0/1/2), chains Deflate/Zstd post-filter, then calls lercz C ABI via lerc_getBlobInfo + lerc_decode.
	src/decoder.zig = Core TIFF decoder; delegates strict LZW to lzwz; validates each chunk's decoded extent (ExpectedExtent min..max) — exact for non-subsampled, TIFF 6.0 §21 YCbCr chroma-subsampling range (final strip may pad to full RowsPerStrip) for chunky subsampled YCbCr.
	src/findings.zig = Typed source/code callback ABI with four-way verdicts, mapped codes, and offset provenance
	src/geotiff.zig = GeoTIFF metadata parser: strict parseFromIfd → Metadata with pixel_scale, tiepoints, transformation, key directory + double/ascii params. Reads DOUBLE payloads via cachedValueBytes since Ifd.arrayElementU64 is SHORT/LONG/LONG8 only.
	src/lib.zig = Full public tiffz API; re-exports parser-owned core types and exact jpegz/lzwz module identities downstream.
	src/parser.zig = Codec-free public Zig module exporting TIFF source/header/IFD/tag parsing as tiffz-parser.
	src/parser_decoder.zig = Codec-free lazy TIFF IFD-chain decoder compatible with the rawz parser surface.
	src/tags.zig = Named TIFF tag constants (incl. ycbcr_subsampling=530) + compression/photometric/planar code enums.
	tests/dual_module_test.zig = Blocking Zig 0.16 single-ownership gate proving full tiffz and tiffz-parser coexist with identical shared parser types.
	tests/fixture_test.zig = Independent TIFF fixture and inline-byte regressions, including strict LZW terminator and decoded-extent coverage.
	tests/fixtures/geotiff = GeoTIFF fixtures: gray16_geotiff.tif is 16x16 EPSG:4326 grayscale with WGS 84 GeoKeyDirectory (7 keys, 2 doubles, ASCII citation).
	tests/fixtures/labeled_good = Byte-verbatim copies of validate's labeled-good corpus at ~/Code/validate_gui/ground_truth_examples/tiff/. Distinct dir to sidestep name-collision drift with tests/fixtures/tiled/.
	tests/fixtures/lerc = GDAL-produced LERC-in-TIFF fixtures: gray16_lerc (bare), gray16_lerc_deflate (post-filter=1), gray16_lerc_zstd (post-filter=2), rgb16_lerc (chunky RGB).
	tests/fixtures/lerc_oracle = ImageMagick RGBA oracles for tests/fixtures/lerc/.
	tests/fixtures/photometric/ycbcr_tiled_uncompressed_sub2x2.tif = Real libtiff 4.7.1 tiled chunky YCbCr 2:2 uncompressed fixture (16x16, one 384-byte tile); product-path coverage for the .tile subsampling extent branch.
	tests/jpeg_validation_closure_test = Static artifact gate excluding external JPEG-family decoder and oracle symbols/store references
	tests/jpeg_validation_consumer.zig = Production-shaped consumer proving tiffz reaches jpegz structural validation without pixel decode
	tests/parser_closure_test = Blocking recursive import, compiler-edge, runtime, and ELF linkage gate for tiffz-parser.
	tests/parser_consumer.zig = Downstream tiffz-parser contract tests: classic/BigTIFF, lazy chains, cycles, limits, and allocation failures.
	tests/parser_proxy.zig = Rawz-like test module proving Validate can inject one tiffz dependency instance into a parser consumer.
]

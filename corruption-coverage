#!/usr/bin/env bash
# Estimate tiffz corrupt-input detection on known-good TIFF seeds.
#
# corruption-reader draws each case. tiffz validate scores it.
# mutation_definition=validate-mutation-v3
#   sniper            1 bit
#   bolter            1 byte XOR 0xFF
#   shotgun           corruption-reader profile shotgun_variable
#                     (8 to 16 distinct bits in one 32-byte window)
#   nuke              4096-byte overwrite
#   exit 1            detection
#   exit 0            accept, unless a non-reach finding changed
#   exit 0 + finding  a new finding other than code 16 is a detection
#   finding 16 only   reach, not a trial
#   exit 4            reach, not a trial
#   a no-op draw is not a trial
#   a signal or timeout's 124 is a crash, counted apart
# The unmutated seed must validate. Its sha256 and length are printed.
# A 95% Wilson interval is reported for detections among decisive trials.
# The run is precise when that interval's half-width is within --margin.

set -u

root="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
profiles=(sniper bolter shotgun nuke)
declare -A seed_non16=()
declare -A seed_code16=()
z_95=1.959963984540054

mode=campaign
margin=0.05
trials=""
master=42
tiffz_bin="${TIFFZ:-}"
cr_bin="${CORRUPTION_READER:-}"
tiffdump_bin="${TIFFDUMP:-}"
tiffinfo_bin="${TIFFINFO:-}"
pigz_bin="${PIGZ:-}"
# Weakest integrity first: a tie between classes takes the weaker one.
classes=(uncompressed unchecked checksummed)
# tiffdump shortens arrays to 24 items unless -m raises the limit.
tiffdump_items=1000000000
declare -A seed_class=()
declare -A seed_ranges=()
declare -A seed_zlib=()
declare -A seed_diag=()
declare -A seed_bytes=()
# Per-case results, set by functions rather than printed, so scoring a case
# does not fork a subshell for each of them.
outcome=""
bound=""
diag=""
batch_decisive=0
seeds_file=""
floors_file=""
master_set=0
trials_set=0
write_floors=0
generator_rev=""
floors_exists=0
floors_identity=""
floors_pinned=""
declare -A plan_per=()
declare -A plan_batches=()
declare -A drawn_batches=()
declare -A seed_sha=()

usage() {
	cat <<'EOF'
usage: corruption-coverage [options]

Draw sniper, bolter, shotgun, and nuke cases with corruption-reader and
score them with tiffz validate. mutation_definition=validate-mutation-v3.
Shotgun is corruption-reader's shotgun_variable profile: 8 to 16 distinct
bits in one 32-byte window. Seeds default to the known-good corpus in
tests/fuzz/fuzz.zig. The same --master reproduces the draws.

A decisive trial is a detection or an accept. Exit 1 is a detection. Exit 0
is an accept unless a finding other than code 16 differs from the unmutated
seed; that difference is a detection. Finding 16 alone, and exit 4, are
reach and are not trials. A corruption-reader no-op is not a trial. The
detection rate is detections / decisive trials. Each profile gets a 95%
Wilson interval.

Each seed is mapped with libtiff's tiffdump, independently of tiffz, and
classed by the integrity protection of the codec holding most of its
strip and tile bytes (a tie takes the weaker class):
  uncompressed  Compression 1. Every value is a legal sample.
  unchecked     LZW, PackBits, CCITT, JPEG, Zstd without a content
                checksum, and any other codec without an integrity check.
  checksummed   Deflate (zlib Adler-32) and LERC (Fletcher-32).
uncompressed is the worst case and checksummed the best case; the
"ceilings" line names both per profile.

Each case is bounded independently of tiffz:
  free   every changed byte is an uncompressed sample. The file is still
         a valid TIFF, so no validator can detect it.
  clean  libtiff's tiffinfo -D reads every directory and strip with the
         seed's own diagnostics, and every touched Deflate stream still
         passes pigz's Adler-32 check. Probably undetectable, but a
         stricter validator can still catch some.
  open   everything else, including any change of length.
ceiling = (decisive - free) / decisive is an upper bound on the detection
rate. ceiling_est = (decisive - free - clean) / decisive estimates it.
open_rate is detections among open cases. A detection of a free case is
a false_alarm (tiffz rejected a valid file); a detection of a clean case
is stricter (tiffz caught what libtiff accepts).
precise=yes when the half-width is at most --margin (default 0.05), which
needs 385 decisive trials at a rate near one half and fewer when the rate
is near 0 or 1.

Exit 0 means every profile is precise and no seed was rejected, no draw
failed, and tiffz did not crash. The rate itself is not a pass/fail gate.

With --floors, the exact set of detected cases is the gate. The file is
written by --write-floors, never by hand. It records the campaign's
identity (master, trials, the corruption-reader version and
--generator-rev, its RNG and case derivation, a sha256 of each resolved
profile, and each seed's path and sha256), each profile's draw plan, and
every detected case as profile, seed and round. Batch k of a profile
draws PER cases from seed k mod SEEDS at round k * PER, so whether one
case is detected never moves another. The gate fails when the identity
differs ("case set stale"), when a pinned case is no longer detected
("case lost") or an unpinned one is ("case new"), and on a false alarm, a
crash, or a profile short of N decisive trials. Precision is not checked.
--write-floors draws batches until each profile has N decisive trials,
prints the cases added and removed and the old and new count per profile
and class, and rewrites the file. It refuses on a false alarm, a crash or
a short profile.

options:
  -h, --help                 show this text
  --list-seeds               print the default known-good corpus
  --summarize                score a TSV of "profile<TAB>outcome" on stdin
  --seeds-file PATH          one seed path per line, instead of the corpus
  --master SEED              corruption-reader master seed (default 42)
  --margin P                 Wilson half-width target in (0, 1] (default 0.05)
  --trials N                 decisive trials to collect per profile
  --floors PATH              gate on the pinned detected cases (see above)
  --write-floors             rewrite the --floors file from this run
  --generator-rev REV        corruption-reader source revision, recorded
                             in the --floors identity
  --tiffz PATH               tiffz executable
  --corruption-reader PATH   corruption-reader executable
  --tiffdump PATH            libtiff tiffdump executable (seed layout oracle)
  --tiffinfo PATH            libtiff tiffinfo executable (decode oracle)
  --pigz PATH                pigz executable (independent zlib Adler-32 check)
EOF
}

die() {
	printf 'corruption-coverage: %s\n' "$1" >&2
	exit 2
}

default_seeds() {
	awk '
		/const seed_corpus/ { grab = 1; next }
		grab && /};/ { exit }
		grab && /"/ {
			line = $0
			while (match(line, /"[^"]+"/)) {
				print substr(line, RSTART + 1, RLENGTH - 2)
				line = substr(line, RSTART + RLENGTH)
			}
		}
	' "$root/tests/fuzz/fuzz.zig"
}

load_seeds() {
	if [ -n "$seeds_file" ]; then
		awk 'NF && $0 !~ /^#/ { print }' "$seeds_file"
	else
		default_seeds
	fi
}

worst_case_trials() {
	awk -v margin="$1" -v z="$z_95" 'BEGIN {
		if (margin <= 0 || margin > 1) exit 2
		z2 = z * z
		n = z2 * 0.25 / (margin * margin)
		c = int(n)
		if (c < n) c++
		if (c < 1) c = 1
		print c
	}'
}

# Print one profile line. Exit 1 when that profile is not precise.
print_profile() {
	awk -v profile="$1" -v detect="$2" -v accept="$3" -v reach="$4" \
		-v noop="$5" -v crash="$6" -v harness="$7" -v margin="$8" \
		-v z="$z_95" 'BEGIN {
		decisive = detect + accept
		printf "%s decisive=%d detect=%d accept=%d reach=%d noop=%d crash=%d harness=%d ", \
			profile, decisive, detect, accept, reach, noop, crash, harness
		if (decisive < 1) {
			printf "rate=na low=na high=na half=na precise=no\n"
			exit 1
		}
		z2 = z * z
		den = decisive + z2
		center = (detect + z2 / 2) / den
		inner = (detect * accept / decisive) + z2 / 4
		if (inner < 0) inner = 0
		halfspan = z / den * sqrt(inner)
		low = center - halfspan
		high = center + halfspan
		if (low < 0) low = 0
		if (high > 1) high = 1
		half = (high - low) / 2
		rate = detect / decisive
		precise = "yes"
		if (crash > 0 || harness > 0 || half > margin + 1e-12) precise = "no"
		printf "rate=%.6f low=%.6f high=%.6f half=%.6f precise=%s\n", \
			rate, low, high, half, precise
		exit (precise == "yes" ? 0 : 1)
	}'
}

# Print one profile's ceiling line for one seed class from a ledger.
# With $4 = brief, print only its ceiling and ceiling_est.
print_class() {
	awk -v profile="$1" -v class="$2" -v brief="${4:-}" -F '\t' '
		$1 == profile && $3 == class && ($2 == "detect" || $2 == "accept") {
			n++
			if ($2 == "detect") k++
			if ($4 == "free") { free++; if ($2 == "detect") fa++ }
			else if ($4 == "clean") { clean++; if ($2 == "detect") st++ }
		}
		function rate(num, den) { return den > 0 ? sprintf("%.6f", num / den) : "na" }
		END {
			ceilings = "ceiling=" rate(n - free, n) " ceiling_est=" rate(n - free - clean, n)
			if (brief == "brief") { printf "%s", ceilings; exit }
			printf "class %s %s decisive=%d detect=%d free=%d clean=%d %s ", profile, class, n, k, free, clean, ceilings
			printf "open_rate=%s false_alarm=%d stricter=%d\n", rate(k - fa - st, n - free - clean), fa, st
		}
	' "$3"
}

# Name the worst case (no integrity check, every value legal) and the best
# case (a checksum over the data) for one profile.
print_ceilings() {
	printf 'ceilings %s worst_case=uncompressed %s best_case=checksummed %s\n' "$1" \
		"$(print_class "$1" uncompressed "$2" brief)" "$(print_class "$1" checksummed "$2" brief)"
}

count_file() {
	if [ -f "$1" ]; then
		wc -l <"$1" | tr -d '[:space:]'
	else
		printf '0'
	fi
}

summarize() {
	local dir profile outcome
	local overall=0
	dir="$(mktemp -d "${TMPDIR:-/tmp}/tiffz-coverage-sum.XXXXXX")"
	touch "$dir/order"
	local class bound
	while IFS="$(printf '\t')" read -r profile outcome class bound _case; do
		[ -n "${profile:-}" ] || continue
		printf '%s\t%s\t%s\t%s\n' "$profile" "$outcome" "${class:-}" "${bound:-}" >>"$dir/ledger"
		case "$outcome" in
			detect|accept|reach|noop|crash|harness) ;;
			*)
				rm -rf -- "$dir"
				die "bad outcome: $outcome"
				;;
		esac
		if [ ! -e "$dir/seen.$profile" ]; then
			printf '%s\n' "$profile" >>"$dir/order"
			: >"$dir/seen.$profile"
		fi
		printf 'x\n' >>"$dir/n.$profile.$outcome"
	done
	while IFS= read -r profile; do
		local detect accept reach noop crash harness
		detect="$(count_file "$dir/n.$profile.detect")"
		accept="$(count_file "$dir/n.$profile.accept")"
		reach="$(count_file "$dir/n.$profile.reach")"
		noop="$(count_file "$dir/n.$profile.noop")"
		crash="$(count_file "$dir/n.$profile.crash")"
		harness="$(count_file "$dir/n.$profile.harness")"
		print_profile "$profile" "$detect" "$accept" "$reach" "$noop" \
			"$crash" "$harness" "$margin" || overall=1
		for class in "${classes[@]}"; do
			print_class "$profile" "$class" "$dir/ledger"
		done
		print_ceilings "$profile" "$dir/ledger"
	done <"$dir/order"
	rm -rf -- "$dir"
	return "$overall"
}

resolve_tools() {
	local pf
	pf="$("$root/tools/pf" 2>/dev/null)" || pf=""
	if [ -z "$tiffz_bin" ]; then
		if [ -n "$pf" ] && [ -x "$root/bin/$pf/tiffz" ]; then
			tiffz_bin="$root/bin/$pf/tiffz"
		elif command -v tiffz >/dev/null 2>&1; then
			tiffz_bin="$(command -v tiffz)"
		else
			die "tiffz not found; pass --tiffz"
		fi
	fi
	if [ ! -x "$tiffz_bin" ]; then
		die "tiffz is not executable: $tiffz_bin"
	fi
	if [ -z "$cr_bin" ]; then
		# The sibling checkout's bin/<PF>/, then its pre-PF bin/linux/<arch>/
		# layout until corruption_reader migrates.
		local sibling="$root/../corruption_reader/bin"
		if command -v corruption-reader >/dev/null 2>&1; then
			cr_bin="$(command -v corruption-reader)"
		elif [ -n "$pf" ] && [ -x "$sibling/$pf/corruption-reader" ]; then
			cr_bin="$sibling/$pf/corruption-reader"
		elif [ -x "$sibling/linux/$(uname -m)/corruption-reader" ]; then
			cr_bin="$sibling/linux/$(uname -m)/corruption-reader"
		else
			die "corruption-reader not found; pass --corruption-reader"
		fi
	fi
	if [ ! -x "$cr_bin" ]; then
		die "corruption-reader is not executable: $cr_bin"
	fi
	if [ -z "$tiffdump_bin" ]; then
		tiffdump_bin="$(command -v tiffdump 2>/dev/null)" || die "tiffdump (libtiff) not found; pass --tiffdump"
	fi
	if [ -z "$tiffinfo_bin" ]; then
		tiffinfo_bin="$(command -v tiffinfo 2>/dev/null)" || die "tiffinfo (libtiff) not found; pass --tiffinfo"
	fi
	if [ -z "$pigz_bin" ]; then
		pigz_bin="$(command -v pigz 2>/dev/null)" || die "pigz not found; pass --pigz"
	fi
}

reader_profile() {
	# Vocabulary name -> corruption-reader profile. Shotgun is the
	# variable 8-to-16-bit window, not the fixed 16-bit profile.
	case "$1" in
		shotgun) printf 'shotgun_variable\n' ;;
		*) printf '%s\n' "$1" ;;
	esac
}

# Print "KEY|FLAG" for tiffz's JSON report in $1, in one process. KEY is
# the finding codes other than 16, ascending and comma-joined (empty when
# there are none). FLAG is yes when code 16 is present, otherwise no.
finding_key() {
	awk '
		BEGIN { n = 0; found = 0 }
		{
			s = $0
			while (match(s, /"code":[0-9]+/)) {
				code = substr(s, RSTART + 7, RLENGTH - 7)
				if (code == "16") found = 1
				else c[n++] = code + 0
				s = substr(s, RSTART + RLENGTH)
			}
		}
		END {
			for (i = 1; i < n; i++) {
				v = c[i]
				for (j = i - 1; j >= 0 && c[j] > v; j--) c[j + 1] = c[j]
				c[j + 1] = v
			}
			key = ""
			for (i = 0; i < n; i++) key = key (i ? "," : "") c[i]
			print key "|" (found ? "yes" : "no")
		}
	' "$1"
}

# corruption-reader's JSONL report in $1 to one word per non-blank line:
# noop (no mutation applied), harness (nothing emitted) or emit. One
# process per batch rather than three per case.
report_kinds() {
	awk '
		function field(key,    pat, i, rest, q, n) {
			pat = "\"" key "\":"
			i = index($0, pat)
			if (i == 0) return ""
			rest = substr($0, i + length(pat))
			if (substr(rest, 1, 4) == "null") return "null"
			if (substr(rest, 1, 1) == "\"") {
				rest = substr(rest, 2)
				q = index(rest, "\"")
				return substr(rest, 1, q - 1)
			}
			n = match(rest, /[,}]/)
			return n == 0 ? rest : substr(rest, 1, n - 1)
		}
		$0 == "" { next }
		{
			status = field("status")
			noop = field("noop")
			emitted = field("emitted")
			round = field("round")
			if (round == "" || round == "null") round = "-"
			if (status == "noop" || (noop != "" && noop != "null")) print "noop\t" round
			else if (emitted != "true") print "harness\t" round
			else print "emit\t" round
		}
	' "$1"
}

# Run a command under a 30 s limit. macOS hosts have GNU timeout as
# gtimeout; Linux and the Nix sandbox have timeout.
limited() {
	if command -v gtimeout >/dev/null 2>&1; then
		gtimeout 30 "$@"
	elif command -v timeout >/dev/null 2>&1; then
		timeout 30 "$@"
	else
		"$@"
	fi
}

# Run tiffz validate --json on $1 into $2.
validate_limited() {
	limited "$tiffz_bin" validate --json -- "$1" >"$2" 2>"$work/tiffz.err"
}

# Set diag to libtiff's verdict on reading every directory and strip of
# $1: its exit status and its diagnostics, with the file's own path
# replaced so a seed and its cases compare equal when libtiff says the
# same thing. Trailing newlines are dropped, as command substitution would.
libtiff_diag() {
	local st=0 err=""
	limited "$tiffinfo_bin" -D "$1" >/dev/null 2>"$work/tiffinfo.err" || st=$?
	IFS= read -r -d '' err <"$work/tiffinfo.err" || :
	while [ "${err%$'\n'}" != "$err" ]; do
		err="${err%$'\n'}"
	done
	diag="$st|${err//"$1"/@FILE}"
}

# True when the half-open byte range [$2, $3) of $1 is a zlib stream that
# inflates with a matching Adler-32 trailer.
zlib_ok() {
	tail -c "+$(($2 + 1))" -- "$1" | head -c "$(($3 - $2))" |
		limited "$pigz_bin" -dc >/dev/null 2>&1
}

# True when the Zstd frame at byte $2 of $1 sets Content_Checksum_flag
# (RFC 8878, section 3.1.1.1.1: bit 2 of the frame header descriptor).
zstd_checksummed() {
	local b
	b="$(od -An -tu1 -j "$2" -N5 -- "$1" | tr -s ' ' ' ')"
	set -- $b
	[ "$#" -eq 5 ] && [ "$1" -eq 40 ] && [ "$2" -eq 181 ] && [ "$3" -eq 47 ] && [ "$4" -eq 253 ] &&
		[ $(($5 & 4)) -ne 0 ]
}

# Map a seed with tiffdump and print its class. Write the half-open byte
# ranges of its uncompressed strip and tile data to $2 and those of its
# Deflate streams to $3. A Compression tag that is absent means 1 (TIFF
# 6.0, section 8). Codes: 8 and 32946 Deflate, 34887 LERC, 50000 Zstd.
seed_layout() {
	local seed="$1" ranges="$2" zlib="$3" dump comp start end kind best
	local -A total=([uncompressed]=0 [unchecked]=0 [checksummed]=0)
	dump="$("$tiffdump_bin" -m "$tiffdump_items" "$seed" 2>/dev/null)" || die "tiffdump cannot read seed: $seed"
	while read -r comp start end; do
		case "$comp" in
			1)
				kind=uncompressed
				printf '%s %s\n' "$start" "$end" >>"$ranges"
				;;
			8|32946)
				kind=checksummed
				zlib_ok "$seed" "$start" "$end" || die "seed Deflate stream at $start fails its Adler-32 check: $seed"
				printf '%s %s\n' "$start" "$end" >>"$zlib"
				;;
			34887) kind=checksummed ;;
			50000)
				zstd_checksummed "$seed" "$start" &&
					die "no independent oracle for a Zstd content checksum yet: $seed"
				kind=unchecked
				;;
			*) kind=unchecked ;;
		esac
		total[$kind]=$((total[$kind] + end - start))
	done < <(printf '%s\n' "$dump" | seed_strips)
	best=uncompressed
	for kind in "${classes[@]}"; do
		if [ "${total[$kind]}" -gt "${total[$best]}" ]; then
			best="$kind"
		fi
	done
	printf '%s\n' "$best"
}

# tiffdump output on stdin to "compression start end" per strip or tile.
seed_strips() {
	awk '
		function flush() {
			if (!indir) return
			for (i = 1; i <= noff && i <= ncnt; i++) print comp, off[i], off[i] + cnt[i]
			indir = 0
		}
		function values(line, arr,    v, n) {
			v = line
			sub(/^[^<]*</, "", v)
			sub(/>.*$/, "", v)
			return split(v, arr, " ")
		}
		/^Directory [0-9]+:/ { flush(); indir = 1; comp = 1; noff = 0; ncnt = 0; delete off; delete cnt; next }
		/^Compression \(259\)/ { values($0, tmp); comp = tmp[1] + 0 }
		/^(StripOffsets \(273\)|TileOffsets \(324\))/ { noff = values($0, off) }
		/^(StripByteCounts \(279\)|TileByteCounts \(325\))/ { ncnt = values($0, cnt) }
		END { flush() }
	'
}

# Sum the merged ranges in $1, clipped to $2 bytes.
free_bytes() {
	sort -n -k1,1 -- "$1" | awk -v size="$2" '
		{
			s = $1; e = $2
			if (e > size) e = size
			if (s < last) s = last
			if (e > s) { total += e - s; last = e }
		}
		END { print total + 0 }
	'
}

# Bound case $2 of seed $1 (see --help): "free" when every changed byte
# lies in the seed's uncompressed sample ranges; "clean" when libtiff reads
# it with the seed's diagnostics and every Deflate stream it touches still
# passes Adler-32; else "open". A length change is open. Sets bound.
case_bound() {
	local seed="$1" mutated="$2" size scan ranges="" start end
	size="$(wc -c <"$mutated")"
	if [ "$((size))" -ne "${seed_bytes[$seed]}" ]; then
		bound=open
		return
	fi
	# One pass over the changed offsets: the first line is "all" when each
	# lies in an uncompressed sample range, else "some"; then each Deflate
	# stream range that holds one, once.
	scan="$(cmp -l -- "$seed" "$mutated" 2>/dev/null | awk -v free="${seed_ranges[$seed]}" -v zlib="${seed_zlib[$seed]}" '
		function load(file, s, e,    line, r, n) {
			n = 0
			while ((getline line < file) > 0) { split(line, r, " "); s[n] = r[1]; e[n] = r[2]; n++ }
			return n
		}
		BEGIN { nf = load(free, fs, fe); nz = load(zlib, zs, ze); all = 1 }
		{
			off = $1 - 1
			if (all) {
				hit = 0
				for (i = 0; i < nf; i++) if (off >= fs[i] && off < fe[i]) { hit = 1; break }
				if (!hit) all = 0
			}
			for (i = 0; i < nz; i++) if (off >= zs[i] && off < ze[i]) touched[i] = 1
		}
		END {
			print (all ? "all" : "some")
			for (i = 0; i < nz; i++) if (touched[i]) print zs[i], ze[i]
		}
	')"
	if [ "${scan%%$'\n'*}" = all ]; then
		bound=free
		return
	fi
	libtiff_diag "$mutated"
	if [ "$diag" != "${seed_diag[$seed]//"$seed"/@FILE}" ]; then
		bound=open
		return
	fi
	case "$scan" in
		*$'\n'*) ranges="${scan#*$'\n'}" ;;
	esac
	while read -r start end; do
		[ -n "$start" ] || continue
		if ! zlib_ok "$mutated" "$start" "$end"; then
			bound=open
			return
		fi
	done <<<"$ranges"
	bound=clean
}

# Set outcome for one case. $1 wait status, $2 JSON file, $3 unmutated seed.
classify_tiffz() {
	local status="$1" json="$2" seed="$3"
	# 124 is timeout's status when the decoder did not finish.
	if [ "$status" -ge 128 ] || [ "$status" -eq 124 ]; then
		outcome=crash
	elif [ "$status" -eq 1 ]; then
		outcome=detect
	elif [ "$status" -eq 4 ]; then
		outcome=reach
	elif [ "$status" -eq 0 ]; then
		local key
		key="$(finding_key "$json")"
		if [ "${key%|*}" != "${seed_non16[$seed]:-}" ]; then
			outcome=detect
		elif [ "${key##*|}" != "${seed_code16[$seed]:-no}" ]; then
			outcome=reach
		else
			outcome=accept
		fi
	else
		outcome=harness
	fi
}

score_batch() {
	# Append outcomes for one corruption-reader invocation.
	# $1 profile  $2 report  $3 path list  $4 reader exit  $5 outcome file  $6 seed
	# Adds the batch's detections and accepts to batch_decisive. The emitted
	# cases live in the batch directory, which the caller removes.
	local profile="$1" report="$2" pathfile="$3" reader_status="$4" out="$5" seed="$6"
	local kind path class="${seed_class[$seed]}" json="$work/tiffz.json"
	if [ "$reader_status" -eq 2 ] || [ ! -s "$report" ]; then
		printf '%s\tharness\n' "$profile" >>"$out"
		return
	fi
	local -a paths=()
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		paths+=("$path")
	done <"$pathfile"
	local cursor=0
	local round
	while IFS="$(printf '\t')" read -r kind round <&3; do
		if [ "$kind" = noop ]; then
			printf '%s\tnoop\n' "$profile" >>"$out"
			continue
		fi
		if [ "$kind" != emit ] || [ "$cursor" -ge "${#paths[@]}" ]; then
			printf '%s\tharness\n' "$profile" >>"$out"
			continue
		fi
		path="${paths[$cursor]}"
		cursor=$((cursor + 1))
		local tiffz_status=0
		: >"$json"
		validate_limited "$path" "$json" || tiffz_status=$?
		case_bound "$seed" "$path"
		classify_tiffz "$tiffz_status" "$json" "$seed"
		# Seed and round identify the case for the --floors case set.
		printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$profile" "$outcome" "$class" "$bound" "$seed" "$round" >>"$out"
		case "$outcome" in
			detect|accept) batch_decisive=$((batch_decisive + 1)) ;;
		esac
	done 3< <(report_kinds "$report")
}

# Draw and score one batch: $4 cases of profile $1 from seed $2, starting
# at round $3, appended to ledger $5. Sets batch_decisive.
draw_batch() {
	local profile="$1" seed="$2" round="$3" count="$4" ledger="$5"
	local batch="$work/batch" reader_status=0 draw_profile
	mkdir -p "$batch"
	local report="$batch/report.jsonl" paths="$batch/paths"
	draw_profile="$(reader_profile "$profile")"
	"$cr_bin" corrupt "$draw_profile" \
		--master "$master" \
		--round "$round" \
		--count "$count" \
		--emit tmp \
		--tmp-dir "$batch" \
		--report "$report" \
		-- "$seed" >"$paths" 2>"$batch/reader.err" || reader_status=$?
	batch_decisive=0
	score_batch "$profile" "$report" "$paths" "$reader_status" "$ledger" "$seed"
	rm -rf -- "$batch"
}

# The --floors draw plan for profile $1: batch k draws $2 cases from seed
# k mod (corpus size) at round k * $2, so no outcome moves another case.
# With $3 > 0, draw exactly $3 batches (the pinned plan); with 0, draw
# until $target decisive trials or 4 * $target cases (--write-floors).
# Reads $seeds and $target from campaign. Sets drawn_batches[$1].
planned_draw() {
	local profile="$1" per="$2" want="$3" ledger="$4"
	local -a corpus=()
	local seed k=0 decisive=0 max
	while IFS= read -r seed; do
		[ -n "$seed" ] && corpus+=("$seed")
	done <<EOF
$seeds
EOF
	max=$(((target * 4 + per - 1) / per))
	while :; do
		if [ "$want" -gt 0 ]; then
			[ "$k" -lt "$want" ] || break
		else
			{ [ "$decisive" -lt "$target" ] && [ "$k" -lt "$max" ]; } || break
		fi
		seed="${corpus[$((k % ${#corpus[@]}))]}"
		draw_batch "$profile" "$seed" "$((k * per))" "$per" "$ledger"
		decisive=$((decisive + batch_decisive))
		k=$((k + 1))
		if [ $((k % ${#corpus[@]})) -eq 0 ]; then
			printf 'progress %s decisive=%s batches=%s\n' "$profile" "$decisive" "$k" >&2
		fi
	done
	drawn_batches["$profile"]="$k"
}

# Print the --floors identity of this run, one tab-separated line each.
# Any difference from the file's identity makes its case set stale.
current_identity() {
	local about first rec profile hash seed
	about="$("$cr_bin" --about 2>/dev/null)" || die "corruption-reader --about failed"
	# Drop the platform suffix, e.g. " (linux/x86_64)": draws are the same
	# on every platform.
	about="${about% (*)}"
	first="$(printf '%s\n' "$seeds" | awk 'NF { print; exit }')"
	rec="$("$cr_bin" draw sniper --master "$master" --round 0 -- "$first" 2>/dev/null)" ||
		die "corruption-reader draw failed on $first"
	printf 'master\t%s\n' "$master"
	printf 'trials\t%s\n' "$target"
	printf 'generator\t%s\t%s\n' "$about" "${generator_rev:-unpinned}"
	printf '%s\n' "$rec" | awk '
		function field(key,    pat, i, rest, q) {
			pat = "\"" key "\":\""
			i = index($0, pat)
			if (i == 0) return "missing"
			rest = substr($0, i + length(pat))
			q = index(rest, "\"")
			return substr(rest, 1, q - 1)
		}
		NR == 1 { printf "rng\t%s\ncase_derivation\t%s\n", field("rng"), field("case_derivation") }
	'
	for profile in "${profiles[@]}"; do
		hash="$("$cr_bin" profile show "$(reader_profile "$profile")" 2>/dev/null | sha256sum | awk '{ print $1 }')"
		printf 'profile\t%s\t%s\n' "$profile" "$hash"
	done
	while IFS= read -r seed; do
		[ -n "$seed" ] || continue
		printf 'seed\t%s\t%s\n' "$seed" "${seed_sha[$seed]}"
	done <<EOF
$seeds
EOF
}

campaign() {
	local seeds nseeds target cap seed profile
	local accepted=0 rejected=0
	resolve_tools
	seeds="$(load_seeds)"
	if [ -z "$seeds" ]; then
		die "no seeds"
	fi
	nseeds="$(printf '%s\n' "$seeds" | awk 'NF { n++ } END { print n+0 }')"
	if [ -n "$trials" ]; then
		target="$trials"
	else
		target="$(worst_case_trials "$margin")" || die "margin must be in (0, 1]"
	fi
	case "$target" in
		''|*[!0-9]*) die "trials must be a positive integer" ;;
	esac
	if [ "$target" -lt 1 ]; then
		die "trials must be a positive integer"
	fi
	cap=$((target * 4))
	printf 'mutation_definition=validate-mutation-v3\n'
	printf 'shotgun_profile=shotgun_variable\n'
	printf 'master=%s margin=%.6f confidence=0.95 trials=%s\n' "$master" "$margin" "$target"
	printf 'reader=%s\n' "$("$cr_bin" --about 2>/dev/null || printf 'unknown\n')"
	printf 'tiffz=%s\n' "$tiffz_bin"

	while IFS= read -r seed; do
		[ -n "$seed" ] || continue
		local st=0
		if [ ! -f "$seed" ]; then
			rejected=$((rejected + 1))
			printf 'specificity reject %s missing\n' "$seed"
			continue
		fi
		local spec_json="$work/spec.json"
		: >"$spec_json"
		validate_limited "$seed" "$spec_json" || st=$?
		if [ "$st" -eq 0 ]; then
			local hash bytes
			hash="$(sha256sum -- "$seed" | awk '{ print $1 }')"
			bytes="$(wc -c <"$seed" | tr -d '[:space:]')"
			printf 'specificity sha256=%s bytes=%s\n' "$hash" "$bytes"
			seed_sha["$seed"]="$hash"
			local key
			key="$(finding_key "$spec_json")"
			seed_non16["$seed"]="${key%|*}"
			seed_code16["$seed"]="${key##*|}"
			seed_bytes["$seed"]="$bytes"
			local ranges="$work/ranges.$accepted" zlib="$work/zlib.$accepted" class
			: >"$ranges"
			: >"$zlib"
			class="$(seed_layout "$seed" "$ranges" "$zlib")" || exit 2
			seed_class["$seed"]="$class"
			seed_ranges["$seed"]="$ranges"
			seed_zlib["$seed"]="$zlib"
			libtiff_diag "$seed"
			seed_diag["$seed"]="$diag"
			printf 'layout %s class=%s free_bytes=%s bytes=%s\n' "$seed" "$class" "$(free_bytes "$ranges" "$bytes")" "$bytes"
			accepted=$((accepted + 1))
		else
			rejected=$((rejected + 1))
			printf 'specificity reject %s exit %s\n' "$seed" "$st"
		fi
	done <<EOF
$seeds
EOF
	printf 'specificity seeds=%s accepted=%s rejected=%s\n' "$nseeds" "$accepted" "$rejected"
	if [ "$rejected" -ne 0 ]; then
		return 1
	fi

	local fixed_per=$(((target + nseeds - 1) / nseeds))
	if [ -n "$floors_file" ]; then
		local identity
		identity="$(current_identity)" || exit 2
		if [ "$write_floors" -eq 0 ]; then
			local plan_ok=1
			for profile in "${profiles[@]}"; do
				[ "${plan_per[$profile]:-}" = "$fixed_per" ] || plan_ok=0
			done
			if [ "$identity" != "$floors_identity" ] || [ "$plan_ok" -eq 0 ]; then
				printf 'case set stale: regenerate with --write-floors\n'
				diff <(printf '%s\n' "$floors_identity") <(printf '%s\n' "$identity") | sed 's/^/stale /'
				[ "$plan_ok" -eq 1 ] || printf 'stale plan: per must be %s for every profile\n' "$fixed_per"
				return 1
			fi
		fi
	fi

	local ledger="$work/ledger"
	: >"$ledger"
	local overall=0
	for profile in "${profiles[@]}"; do
		if [ -n "$floors_file" ]; then
			local want=0
			[ "$write_floors" -eq 1 ] || want="${plan_batches[$profile]}"
			planned_draw "$profile" "$fixed_per" "$want" "$ledger"
			continue
		fi
		local decisive=0 attempts=0 round_base=0
		local per
		if [ -n "$trials" ]; then
			per=$(((target + nseeds - 1) / nseeds))
		else
			# A pass across the corpus, then re-check the interval.
			per=$(((96 + nseeds - 1) / nseeds))
		fi
		if [ "$per" -lt 1 ]; then
			per=1
		fi
		local guard=0
		while [ "$decisive" -lt "$target" ] && [ "$attempts" -lt "$cap" ] && [ "$guard" -lt 100 ]; do
			guard=$((guard + 1))
			local before="$decisive"
			while IFS= read -r seed; do
				[ -n "$seed" ] || continue
				[ "$decisive" -lt "$target" ] || break
				[ "$attempts" -lt "$cap" ] || break
				local draw=$((target - decisive))
				if [ "$draw" -gt "$per" ]; then
					draw="$per"
				fi
				local room=$((cap - attempts))
				if [ "$draw" -gt "$room" ]; then
					draw="$room"
				fi
				if [ "$draw" -lt 1 ]; then
					break
				fi
				draw_batch "$profile" "$seed" "$round_base" "$draw" "$ledger"
				round_base=$((round_base + draw))
				attempts=$((attempts + draw))
				decisive=$((decisive + batch_decisive))
			done <<EOF
$seeds
EOF
			printf 'progress %s decisive=%s attempts=%s\n' "$profile" "$decisive" "$attempts" >&2
			if [ "$decisive" -eq "$before" ]; then
				break
			fi
			# Without a fixed --trials count, stop once the observed
			# interval is already within the margin.
			if [ -z "$trials" ] && [ "$decisive" -ge 1 ]; then
				local half_now
				half_now="$(awk -v profile="$profile" -F '\t' -v z="$z_95" '
					$1 == profile && $2 == "detect" { k++ }
					$1 == profile && $2 == "accept" { a++ }
					END {
						n = k + a
						if (n < 1) { print "na"; exit }
						z2 = z * z
						den = n + z2
						center = (k + z2 / 2) / den
						inner = (k * a / n) + z2 / 4
						if (inner < 0) inner = 0
						span = z / den * sqrt(inner)
						low = center - span
						high = center + span
						if (low < 0) low = 0
						if (high > 1) high = 1
						printf "%.10f\n", (high - low) / 2
					}
				' "$ledger")"
				if [ "$half_now" != "na" ] && awk -v half="$half_now" -v margin="$margin" 'BEGIN { exit !(half <= margin + 1e-12) }'; then
					break
				fi
			fi
		done
	done

	local summary_status=0
	summarize <"$ledger" || summary_status=$?
	if [ -n "$floors_file" ]; then
		if [ "$write_floors" -eq 1 ]; then
			write_floors_file "$ledger" "$identity" "$fixed_per"
		else
			check_floors "$ledger"
		fi
		return $?
	fi
	return "$summary_status"
}

# Read --floors, the case-set file --write-floors writes (see usage).
# Identity lines are kept verbatim for the stale check. A master or trial
# count given on the command line must agree with the file's, except with
# --write-floors, where it replaces it. --write-floors may start a new file.
load_floors() {
	if [ "$write_floors" -eq 1 ] && [ ! -e "$floors_file" ]; then
		return 0
	fi
	[ -r "$floors_file" ] || die "cannot read floors file: $floors_file"
	floors_exists=1
	local tab line kind a b c f_master="" f_trials="" profile
	tab="$(printf '\t')"
	local -a ident=() pins=()
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
			''|'#'*) continue ;;
		esac
		IFS="$tab" read -r kind a b c <<<"$line"
		case "$kind" in
			master)
				f_master="$a"
				ident+=("$line")
				;;
			trials)
				[[ "$a" =~ ^[0-9]+$ ]] || die "floors: cannot parse line: $line"
				f_trials="$a"
				ident+=("$line")
				;;
			generator|rng|case_derivation|profile|seed)
				ident+=("$line")
				;;
			plan)
				case " ${profiles[*]} " in
					*" $a "*) ;;
					*) die "floors: unknown profile $a" ;;
				esac
				[[ "$b" =~ ^per=([0-9]+)$ ]] || die "floors: cannot parse line: $line"
				plan_per["$a"]="${BASH_REMATCH[1]}"
				[[ "$c" =~ ^batches=([0-9]+)$ ]] || die "floors: cannot parse line: $line"
				plan_batches["$a"]="${BASH_REMATCH[1]}"
				;;
			detect)
				case " ${profiles[*]} " in
					*" $a "*) ;;
					*) die "floors: unknown profile $a" ;;
				esac
				{ [ -n "$b" ] && [[ "$c" =~ ^[0-9]+$ ]]; } || die "floors: cannot parse line: $line"
				pins+=("$a$tab$b$tab$c")
				;;
			*)
				die "floors: cannot parse line: $line"
				;;
		esac
	done <"$floors_file"
	{ [ -n "$f_master" ] && [ -n "$f_trials" ]; } || die "floors: missing master or trials line"
	if [ "$write_floors" -eq 0 ]; then
		if [ "$master_set" -eq 1 ] && [ "$master" != "$f_master" ]; then
			die "floors: --master $master disagrees with master $f_master"
		fi
		if [ "$trials_set" -eq 1 ] && [ "$trials" != "$f_trials" ]; then
			die "floors: --trials $trials disagrees with trials $f_trials"
		fi
		for profile in "${profiles[@]}"; do
			[ -n "${plan_batches[$profile]:-}" ] || die "floors: no plan for $profile"
		done
	fi
	[ "$master_set" -eq 1 ] && [ "$write_floors" -eq 1 ] || master="$f_master"
	[ "$trials_set" -eq 1 ] && [ "$write_floors" -eq 1 ] || trials="$f_trials"
	floors_identity="$(printf '%s\n' "${ident[@]}")"
	if [ "${#pins[@]}" -gt 0 ]; then
		floors_pinned="$(printf '%s\n' "${pins[@]}" | LC_ALL=C sort -u)"
	fi
}

# The detected cases of a ledger as "profile<TAB>seed<TAB>round", sorted.
detected_cases() {
	awk -F '\t' '$2 == "detect" && NF >= 6 { print $1 "\t" $5 "\t" $6 }' "$1" | LC_ALL=C sort -u
}

# Count the cases in list $1 for profile $2 whose seed is in class $3.
cell_count() {
	local p sd r n=0
	while IFS="$(printf '\t')" read -r p sd r; do
		[ "$p" = "$2" ] && [ "${seed_class[$sd]:-}" = "$3" ] && n=$((n + 1))
	done <<EOF
$1
EOF
	printf '%s' "$n"
}

# Print a "floor" line per profile: decisive trials against the trial
# count, and "crash" for a crash or harness failure.
profile_floor() {
	awk -v profile="$1" -v want="$trials" -F '\t' '
		$1 == profile && ($2 == "detect" || $2 == "accept") { n++ }
		$1 == profile && ($2 == "crash" || $2 == "harness") { bad++ }
		END {
			verdict = "ok"
			if (bad > 0) verdict = "crash"
			else if (n < want) verdict = "short"
			printf "floor %s decisive=%d trials=%d %s\n", profile, n, want, verdict
		}
	' "$2"
}

# Print each case of list $2 as "case $1 PROFILE SEED round ROUND".
print_cases() {
	local p sd r
	while IFS="$(printf '\t')" read -r p sd r; do
		[ -n "$p" ] || continue
		printf 'case %s %s %s round %s\n' "$1" "$p" "$sd" "$r"
	done <<EOF
$2
EOF
}

# The gate: each profile reaches the trial count without a crash, every
# pinned case is still detected ("case lost" otherwise), no unpinned case
# is ("case new"), and no free case is detected. A "floor" line per
# profile and class compares detections with the pinned count; equal
# counts can still hide a loss offset by a gain, which the case lines
# name. Exit 1 on any failure.
check_floors() {
	local ledger="$1" profile class status=0 line got lost new
	got="$(detected_cases "$ledger")"
	lost="$(LC_ALL=C comm -23 <(printf '%s\n' "$floors_pinned" | awk 'NF') <(printf '%s\n' "$got" | awk 'NF'))"
	new="$(LC_ALL=C comm -13 <(printf '%s\n' "$floors_pinned" | awk 'NF') <(printf '%s\n' "$got" | awk 'NF'))"
	for profile in "${profiles[@]}"; do
		line="$(profile_floor "$profile" "$ledger")"
		printf '%s\n' "$line"
		case "$line" in *" ok") ;; *) status=1 ;; esac
		for class in "${classes[@]}"; do
			line="$(awk -v profile="$profile" -v class="$class" -v pinned="$(cell_count "$floors_pinned" "$profile" "$class")" -F '\t' '
				$1 == profile && $3 == class && $2 == "detect" { k++; if ($4 == "free") fa++ }
				END {
					verdict = "ok"
					if (fa > 0) verdict = "false_alarm"
					else if (k < pinned) verdict = "below"
					else if (k > pinned) verdict = "above"
					printf "floor %s %s detect=%d pinned=%d false_alarm=%d %s\n", profile, class, k, pinned, fa, verdict
				}
			' "$ledger")"
			printf '%s\n' "$line"
			case "$line" in *" ok") ;; *) status=1 ;; esac
		done
	done
	if [ -n "$lost" ]; then
		print_cases lost "$lost"
		status=1
	fi
	if [ -n "$new" ]; then
		print_cases new "$new"
		printf 'new detections are not pinned: regenerate with --write-floors\n'
		status=1
	fi
	return "$status"
}

# --write-floors: refuse on a crash, a false alarm or a short profile.
# Otherwise print the cases added and removed against the old file and the
# old and new count per profile and class, then replace the file.
write_floors_file() {
	local ledger="$1" identity="$2" per="$3" profile class status=0 line got fa tab
	tab="$(printf '\t')"
	for profile in "${profiles[@]}"; do
		line="$(profile_floor "$profile" "$ledger")"
		printf '%s\n' "$line"
		case "$line" in *" ok") ;; *) status=1 ;; esac
	done
	fa="$(awk -F '\t' '$2 == "detect" && $4 == "free" { n++ } END { print n + 0 }' "$ledger")"
	if [ "$fa" -gt 0 ]; then
		printf 'floor false_alarm=%s\n' "$fa"
		status=1
	fi
	if [ "$status" -ne 0 ]; then
		printf 'floors not written: %s\n' "$floors_file"
		return 1
	fi
	got="$(detected_cases "$ledger")"
	if [ "$floors_exists" -eq 1 ]; then
		print_cases added "$(LC_ALL=C comm -13 <(printf '%s\n' "$floors_pinned" | awk 'NF') <(printf '%s\n' "$got" | awk 'NF'))"
		print_cases removed "$(LC_ALL=C comm -23 <(printf '%s\n' "$floors_pinned" | awk 'NF') <(printf '%s\n' "$got" | awk 'NF'))"
	fi
	for profile in "${profiles[@]}"; do
		for class in "${classes[@]}"; do
			printf 'cell %s %s old=%s new=%s\n' "$profile" "$class" \
				"$(cell_count "$floors_pinned" "$profile" "$class")" "$(cell_count "$got" "$profile" "$class")"
		done
	done
	local tmp="$floors_file.tmp.$$"
	{
		printf '# Corruption detection floors: the exact set of detected cases.\n'
		printf '# Written by ./corruption-coverage --write-floors (nix run .#corruption-floors).\n'
		printf '# Never edit by hand; see docs/corruption_coverage.md.\n'
		printf '%s\n' "$identity"
		for profile in "${profiles[@]}"; do
			printf 'plan\t%s\tper=%s\tbatches=%s\n' "$profile" "$per" "${drawn_batches[$profile]}"
		done
		printf '%s\n' "$got" | awk 'NF' | LC_ALL=C sort -t "$tab" -k1,1 -k2,2 -k3,3n | sed "s/^/detect$tab/"
	} >"$tmp" || { rm -f -- "$tmp"; die "cannot write $tmp"; }
	mv -f -- "$tmp" "$floors_file" || die "cannot replace $floors_file"
	printf 'wrote %s: %s cases\n' "$floors_file" "$(printf '%s\n' "$got" | awk 'NF { n++ } END { print n + 0 }')"
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		-h|--help)
			usage
			exit 0
			;;
		--list-seeds)
			default_seeds
			exit 0
			;;
		--summarize)
			mode=summarize
			shift
			;;
		--margin)
			[ "$#" -ge 2 ] || die "--margin needs a value"
			margin="$2"
			shift 2
			;;
		--trials)
			[ "$#" -ge 2 ] || die "--trials needs a value"
			trials="$2"
			trials_set=1
			shift 2
			;;
		--master)
			[ "$#" -ge 2 ] || die "--master needs a value"
			master="$2"
			master_set=1
			shift 2
			;;
		--tiffz)
			[ "$#" -ge 2 ] || die "--tiffz needs a path"
			tiffz_bin="$2"
			shift 2
			;;
		--corruption-reader)
			[ "$#" -ge 2 ] || die "--corruption-reader needs a path"
			cr_bin="$2"
			shift 2
			;;
		--floors)
			[ "$#" -ge 2 ] || die "--floors needs a path"
			floors_file="$2"
			shift 2
			;;
		--write-floors)
			write_floors=1
			shift
			;;
		--generator-rev)
			[ "$#" -ge 2 ] || die "--generator-rev needs a value"
			generator_rev="$2"
			shift 2
			;;
		--tiffdump)
			[ "$#" -ge 2 ] || die "--tiffdump needs a path"
			tiffdump_bin="$2"
			shift 2
			;;
		--tiffinfo)
			[ "$#" -ge 2 ] || die "--tiffinfo needs a path"
			tiffinfo_bin="$2"
			shift 2
			;;
		--pigz)
			[ "$#" -ge 2 ] || die "--pigz needs a path"
			pigz_bin="$2"
			shift 2
			;;
		--seeds-file)
			[ "$#" -ge 2 ] || die "--seeds-file needs a path"
			seeds_file="$2"
			shift 2
			;;
		--)
			shift
			break
			;;
		*)
			die "unknown argument: $1"
			;;
	esac
done

if [ "$write_floors" -eq 1 ] && [ -z "$floors_file" ]; then
	die "--write-floors needs --floors PATH"
fi
if [ -n "$floors_file" ]; then
	load_floors
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/tiffz-corruption-coverage.XXXXXX")"
cleanup() {
	case "$work" in
		"${TMPDIR:-/tmp}"/tiffz-corruption-coverage.*) rm -rf -- "$work" ;;
	esac
}
trap cleanup EXIT

if [ "$mode" = "summarize" ]; then
	summarize
	exit $?
fi

campaign
exit $?

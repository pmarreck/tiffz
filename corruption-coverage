#!/usr/bin/env bash
# Estimate tiffz corrupt-input detection on known-good TIFF seeds.
#
# corruption-reader draws each case. tiffz validate scores it.
# mutation_definition=validate-mutation-v3
#   sniper            1 bit
#   bolter            1 byte XOR 0xFF
#   shotgun           corruption-reader profile shotgun_variable
#                     (8 to 16 distinct bits in one 32-byte window)
#   nuke              4096-byte overwrite
#   exit 1            detection
#   exit 0            accept, unless a non-reach finding changed
#   exit 0 + finding  a new finding other than code 16 is a detection
#   finding 16 only   reach, not a trial
#   exit 4            reach, not a trial
#   a no-op draw is not a trial
#   a signal or timeout's 124 is a crash, counted apart
# The unmutated seed must validate. Its sha256 and length are printed.
# A 95% Wilson interval is reported for detections among decisive trials.
# The run is precise when that interval's half-width is within --margin.

set -u

root="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
profiles=(sniper bolter shotgun nuke)
declare -A seed_non16=()
declare -A seed_code16=()
z_95=1.959963984540054

mode=campaign
margin=0.05
trials=""
master=42
tiffz_bin="${TIFFZ:-}"
cr_bin="${CORRUPTION_READER:-}"
tiffdump_bin="${TIFFDUMP:-}"
tiffinfo_bin="${TIFFINFO:-}"
pigz_bin="${PIGZ:-}"
# Weakest integrity first: a tie between classes takes the weaker one.
classes=(uncompressed unchecked checksummed)
# tiffdump shortens arrays to 24 items unless -m raises the limit.
tiffdump_items=1000000000
declare -A seed_class=()
declare -A seed_ranges=()
declare -A seed_zlib=()
declare -A seed_diag=()
seeds_file=""
floors_file=""
master_set=0
trials_set=0
declare -A floor_min=()

usage() {
	cat <<'EOF'
usage: corruption-coverage [options]

Draw sniper, bolter, shotgun, and nuke cases with corruption-reader and
score them with tiffz validate. mutation_definition=validate-mutation-v3.
Shotgun is corruption-reader's shotgun_variable profile: 8 to 16 distinct
bits in one 32-byte window. Seeds default to the known-good corpus in
tests/fuzz/fuzz.zig. The same --master reproduces the draws.

A decisive trial is a detection or an accept. Exit 1 is a detection. Exit 0
is an accept unless a finding other than code 16 differs from the unmutated
seed; that difference is a detection. Finding 16 alone, and exit 4, are
reach and are not trials. A corruption-reader no-op is not a trial. The
detection rate is detections / decisive trials. Each profile gets a 95%
Wilson interval.

Each seed is mapped with libtiff's tiffdump, independently of tiffz, and
classed by the integrity protection of the codec holding most of its
strip and tile bytes (a tie takes the weaker class):
  uncompressed  Compression 1. Every value is a legal sample.
  unchecked     LZW, PackBits, CCITT, JPEG, Zstd without a content
                checksum, and any other codec without an integrity check.
  checksummed   Deflate (zlib Adler-32) and LERC (Fletcher-32).
uncompressed is the worst case and checksummed the best case; the
"ceilings" line names both per profile.

Each case is bounded independently of tiffz:
  free   every changed byte is an uncompressed sample. The file is still
         a valid TIFF, so no validator can detect it.
  clean  libtiff's tiffinfo -D reads every directory and strip with the
         seed's own diagnostics, and every touched Deflate stream still
         passes pigz's Adler-32 check. Probably undetectable, but a
         stricter validator can still catch some.
  open   everything else, including any change of length.
ceiling = (decisive - free) / decisive is an upper bound on the detection
rate. ceiling_est = (decisive - free - clean) / decisive estimates it.
open_rate is detections among open cases. A detection of a free case is
a false_alarm (tiffz rejected a valid file); a detection of a clean case
is stricter (tiffz caught what libtiff accepts).
precise=yes when the half-width is at most --margin (default 0.05), which
needs 385 decisive trials at a rate near one half and fewer when the rate
is near 0 or 1.

Exit 0 means every profile is precise and no seed was rejected, no draw
failed, and tiffz did not crash. The rate itself is not a pass/fail gate.

With --floors, the rate is the gate. The file pins the campaign as
"master=SEED trials=N" and gives each profile and seed class a minimum
detection count ("PROFILE CLASS MIN" per line, # starts a comment). Each
profile must reach N decisive trials, each class at least MIN detections
and no false alarm. Precision is not checked.
Draws are deterministic, so any lost detection fails the gate, and
lowering a floor is a deliberate edit to that file.

options:
  -h, --help                 show this text
  --list-seeds               print the default known-good corpus
  --summarize                score a TSV of "profile<TAB>outcome" on stdin
  --seeds-file PATH          one seed path per line, instead of the corpus
  --master SEED              corruption-reader master seed (default 42)
  --margin P                 Wilson half-width target in (0, 1] (default 0.05)
  --trials N                 decisive trials to collect per profile
  --floors PATH              gate on minimum detections (see above)
  --tiffz PATH               tiffz executable
  --corruption-reader PATH   corruption-reader executable
  --tiffdump PATH            libtiff tiffdump executable (seed layout oracle)
  --tiffinfo PATH            libtiff tiffinfo executable (decode oracle)
  --pigz PATH                pigz executable (independent zlib Adler-32 check)
EOF
}

die() {
	printf 'corruption-coverage: %s\n' "$1" >&2
	exit 2
}

default_seeds() {
	awk '
		/const seed_corpus/ { grab = 1; next }
		grab && /};/ { exit }
		grab && /"/ {
			line = $0
			while (match(line, /"[^"]+"/)) {
				print substr(line, RSTART + 1, RLENGTH - 2)
				line = substr(line, RSTART + RLENGTH)
			}
		}
	' "$root/tests/fuzz/fuzz.zig"
}

load_seeds() {
	if [ -n "$seeds_file" ]; then
		awk 'NF && $0 !~ /^#/ { print }' "$seeds_file"
	else
		default_seeds
	fi
}

worst_case_trials() {
	awk -v margin="$1" -v z="$z_95" 'BEGIN {
		if (margin <= 0 || margin > 1) exit 2
		z2 = z * z
		n = z2 * 0.25 / (margin * margin)
		c = int(n)
		if (c < n) c++
		if (c < 1) c = 1
		print c
	}'
}

# Print one profile line. Exit 1 when that profile is not precise.
print_profile() {
	awk -v profile="$1" -v detect="$2" -v accept="$3" -v reach="$4" \
		-v noop="$5" -v crash="$6" -v harness="$7" -v margin="$8" \
		-v z="$z_95" 'BEGIN {
		decisive = detect + accept
		printf "%s decisive=%d detect=%d accept=%d reach=%d noop=%d crash=%d harness=%d ", \
			profile, decisive, detect, accept, reach, noop, crash, harness
		if (decisive < 1) {
			printf "rate=na low=na high=na half=na precise=no\n"
			exit 1
		}
		z2 = z * z
		den = decisive + z2
		center = (detect + z2 / 2) / den
		inner = (detect * accept / decisive) + z2 / 4
		if (inner < 0) inner = 0
		halfspan = z / den * sqrt(inner)
		low = center - halfspan
		high = center + halfspan
		if (low < 0) low = 0
		if (high > 1) high = 1
		half = (high - low) / 2
		rate = detect / decisive
		precise = "yes"
		if (crash > 0 || harness > 0 || half > margin + 1e-12) precise = "no"
		printf "rate=%.6f low=%.6f high=%.6f half=%.6f precise=%s\n", \
			rate, low, high, half, precise
		exit (precise == "yes" ? 0 : 1)
	}'
}

# Print one profile's ceiling line for one seed class from a ledger.
# With $4 = brief, print only its ceiling and ceiling_est.
print_class() {
	awk -v profile="$1" -v class="$2" -v brief="${4:-}" -F '\t' '
		$1 == profile && $3 == class && ($2 == "detect" || $2 == "accept") {
			n++
			if ($2 == "detect") k++
			if ($4 == "free") { free++; if ($2 == "detect") fa++ }
			else if ($4 == "clean") { clean++; if ($2 == "detect") st++ }
		}
		function rate(num, den) { return den > 0 ? sprintf("%.6f", num / den) : "na" }
		END {
			ceilings = "ceiling=" rate(n - free, n) " ceiling_est=" rate(n - free - clean, n)
			if (brief == "brief") { printf "%s", ceilings; exit }
			printf "class %s %s decisive=%d detect=%d free=%d clean=%d %s ", profile, class, n, k, free, clean, ceilings
			printf "open_rate=%s false_alarm=%d stricter=%d\n", rate(k - fa - st, n - free - clean), fa, st
		}
	' "$3"
}

# Name the worst case (no integrity check, every value legal) and the best
# case (a checksum over the data) for one profile.
print_ceilings() {
	printf 'ceilings %s worst_case=uncompressed %s best_case=checksummed %s\n' "$1" \
		"$(print_class "$1" uncompressed "$2" brief)" "$(print_class "$1" checksummed "$2" brief)"
}

count_file() {
	if [ -f "$1" ]; then
		wc -l <"$1" | tr -d '[:space:]'
	else
		printf '0'
	fi
}

summarize() {
	local dir profile outcome
	local overall=0
	dir="$(mktemp -d "${TMPDIR:-/tmp}/tiffz-coverage-sum.XXXXXX")"
	touch "$dir/order"
	local class bound
	while IFS="$(printf '\t')" read -r profile outcome class bound; do
		[ -n "${profile:-}" ] || continue
		printf '%s\t%s\t%s\t%s\n' "$profile" "$outcome" "${class:-}" "${bound:-}" >>"$dir/ledger"
		case "$outcome" in
			detect|accept|reach|noop|crash|harness) ;;
			*)
				rm -rf -- "$dir"
				die "bad outcome: $outcome"
				;;
		esac
		if [ ! -e "$dir/seen.$profile" ]; then
			printf '%s\n' "$profile" >>"$dir/order"
			: >"$dir/seen.$profile"
		fi
		printf 'x\n' >>"$dir/n.$profile.$outcome"
	done
	while IFS= read -r profile; do
		local detect accept reach noop crash harness
		detect="$(count_file "$dir/n.$profile.detect")"
		accept="$(count_file "$dir/n.$profile.accept")"
		reach="$(count_file "$dir/n.$profile.reach")"
		noop="$(count_file "$dir/n.$profile.noop")"
		crash="$(count_file "$dir/n.$profile.crash")"
		harness="$(count_file "$dir/n.$profile.harness")"
		print_profile "$profile" "$detect" "$accept" "$reach" "$noop" \
			"$crash" "$harness" "$margin" || overall=1
		for class in "${classes[@]}"; do
			print_class "$profile" "$class" "$dir/ledger"
		done
		print_ceilings "$profile" "$dir/ledger"
	done <"$dir/order"
	rm -rf -- "$dir"
	return "$overall"
}

json_field() {
	# $1 is the field name. The JSON object is on stdin.
	awk -v key="$1" '
		BEGIN { pat = "\"" key "\":" }
		{
			i = index($0, pat)
			if (i == 0) { print ""; exit }
			rest = substr($0, i + length(pat))
			if (substr(rest, 1, 4) == "null") { print "null"; exit }
			if (substr(rest, 1, 1) == "\"") {
				rest = substr(rest, 2)
				q = index(rest, "\"")
				print substr(rest, 1, q - 1)
				exit
			}
			n = match(rest, /[,}]/)
			if (n == 0) print rest
			else print substr(rest, 1, n - 1)
		}
	'
}

resolve_tools() {
	local pf
	pf="$("$root/tools/pf" 2>/dev/null)" || pf=""
	if [ -z "$tiffz_bin" ]; then
		if [ -n "$pf" ] && [ -x "$root/bin/$pf/tiffz" ]; then
			tiffz_bin="$root/bin/$pf/tiffz"
		elif command -v tiffz >/dev/null 2>&1; then
			tiffz_bin="$(command -v tiffz)"
		else
			die "tiffz not found; pass --tiffz"
		fi
	fi
	if [ ! -x "$tiffz_bin" ]; then
		die "tiffz is not executable: $tiffz_bin"
	fi
	if [ -z "$cr_bin" ]; then
		# The sibling checkout's bin/<PF>/, then its pre-PF bin/linux/<arch>/
		# layout until corruption_reader migrates.
		local sibling="$root/../corruption_reader/bin"
		if command -v corruption-reader >/dev/null 2>&1; then
			cr_bin="$(command -v corruption-reader)"
		elif [ -n "$pf" ] && [ -x "$sibling/$pf/corruption-reader" ]; then
			cr_bin="$sibling/$pf/corruption-reader"
		elif [ -x "$sibling/linux/$(uname -m)/corruption-reader" ]; then
			cr_bin="$sibling/linux/$(uname -m)/corruption-reader"
		else
			die "corruption-reader not found; pass --corruption-reader"
		fi
	fi
	if [ ! -x "$cr_bin" ]; then
		die "corruption-reader is not executable: $cr_bin"
	fi
	if [ -z "$tiffdump_bin" ]; then
		tiffdump_bin="$(command -v tiffdump 2>/dev/null)" || die "tiffdump (libtiff) not found; pass --tiffdump"
	fi
	if [ -z "$tiffinfo_bin" ]; then
		tiffinfo_bin="$(command -v tiffinfo 2>/dev/null)" || die "tiffinfo (libtiff) not found; pass --tiffinfo"
	fi
	if [ -z "$pigz_bin" ]; then
		pigz_bin="$(command -v pigz 2>/dev/null)" || die "pigz not found; pass --pigz"
	fi
}

reader_profile() {
	# Vocabulary name -> corruption-reader profile. Shotgun is the
	# variable 8-to-16-bit window, not the fixed 16-bit profile.
	case "$1" in
		shotgun) printf 'shotgun_variable\n' ;;
		*) printf '%s\n' "$1" ;;
	esac
}

non16_key() {
	awk '
		{
			s = $0
			while (match(s, /"code":[0-9]+/)) {
				code = substr(s, RSTART + 7, RLENGTH - 7)
				if (code != "16") print code
				s = substr(s, RSTART + RLENGTH)
			}
		}
	' "$1" | sort -n | paste -sd, -
}

has_code16() {
	awk '
		BEGIN { found = 0 }
		{
			s = $0
			while (match(s, /"code":[0-9]+/)) {
				code = substr(s, RSTART + 7, RLENGTH - 7)
				if (code == "16") found = 1
				s = substr(s, RSTART + RLENGTH)
			}
		}
		END { print (found ? "yes" : "no") }
	' "$1"
}

# Run a command under a 30 s limit. macOS hosts have GNU timeout as
# gtimeout; Linux and the Nix sandbox have timeout.
limited() {
	if command -v gtimeout >/dev/null 2>&1; then
		gtimeout 30 "$@"
	elif command -v timeout >/dev/null 2>&1; then
		timeout 30 "$@"
	else
		"$@"
	fi
}

# Run tiffz validate --json on $1 into $2.
validate_limited() {
	limited "$tiffz_bin" validate --json -- "$1" >"$2" 2>"$work/tiffz.err"
}

# libtiff's verdict on reading every directory and strip of $1: its exit
# status and its diagnostics, with the file's own path replaced so a seed
# and its cases compare equal when libtiff says the same thing.
libtiff_diag() {
	local st=0 err
	limited "$tiffinfo_bin" -D "$1" >/dev/null 2>"$work/tiffinfo.err" || st=$?
	err="$(cat "$work/tiffinfo.err")"
	printf '%s|%s\n' "$st" "${err//"$1"/@FILE}"
}

# True when the half-open byte range [$2, $3) of $1 is a zlib stream that
# inflates with a matching Adler-32 trailer.
zlib_ok() {
	tail -c "+$(($2 + 1))" -- "$1" | head -c "$(($3 - $2))" |
		limited "$pigz_bin" -dc >/dev/null 2>&1
}

# True when the Zstd frame at byte $2 of $1 sets Content_Checksum_flag
# (RFC 8878, section 3.1.1.1.1: bit 2 of the frame header descriptor).
zstd_checksummed() {
	local b
	b="$(od -An -tu1 -j "$2" -N5 -- "$1" | tr -s ' ' ' ')"
	set -- $b
	[ "$#" -eq 5 ] && [ "$1" -eq 40 ] && [ "$2" -eq 181 ] && [ "$3" -eq 47 ] && [ "$4" -eq 253 ] &&
		[ $(($5 & 4)) -ne 0 ]
}

# Map a seed with tiffdump and print its class. Write the half-open byte
# ranges of its uncompressed strip and tile data to $2 and those of its
# Deflate streams to $3. A Compression tag that is absent means 1 (TIFF
# 6.0, section 8). Codes: 8 and 32946 Deflate, 34887 LERC, 50000 Zstd.
seed_layout() {
	local seed="$1" ranges="$2" zlib="$3" dump comp start end kind best
	local -A total=([uncompressed]=0 [unchecked]=0 [checksummed]=0)
	dump="$("$tiffdump_bin" -m "$tiffdump_items" "$seed" 2>/dev/null)" || die "tiffdump cannot read seed: $seed"
	while read -r comp start end; do
		case "$comp" in
			1)
				kind=uncompressed
				printf '%s %s\n' "$start" "$end" >>"$ranges"
				;;
			8|32946)
				kind=checksummed
				zlib_ok "$seed" "$start" "$end" || die "seed Deflate stream at $start fails its Adler-32 check: $seed"
				printf '%s %s\n' "$start" "$end" >>"$zlib"
				;;
			34887) kind=checksummed ;;
			50000)
				zstd_checksummed "$seed" "$start" &&
					die "no independent oracle for a Zstd content checksum yet: $seed"
				kind=unchecked
				;;
			*) kind=unchecked ;;
		esac
		total[$kind]=$((total[$kind] + end - start))
	done < <(printf '%s\n' "$dump" | seed_strips)
	best=uncompressed
	for kind in "${classes[@]}"; do
		if [ "${total[$kind]}" -gt "${total[$best]}" ]; then
			best="$kind"
		fi
	done
	printf '%s\n' "$best"
}

# tiffdump output on stdin to "compression start end" per strip or tile.
seed_strips() {
	awk '
		function flush() {
			if (!indir) return
			for (i = 1; i <= noff && i <= ncnt; i++) print comp, off[i], off[i] + cnt[i]
			indir = 0
		}
		function values(line, arr,    v, n) {
			v = line
			sub(/^[^<]*</, "", v)
			sub(/>.*$/, "", v)
			return split(v, arr, " ")
		}
		/^Directory [0-9]+:/ { flush(); indir = 1; comp = 1; noff = 0; ncnt = 0; delete off; delete cnt; next }
		/^Compression \(259\)/ { values($0, tmp); comp = tmp[1] + 0 }
		/^(StripOffsets \(273\)|TileOffsets \(324\))/ { noff = values($0, off) }
		/^(StripByteCounts \(279\)|TileByteCounts \(325\))/ { ncnt = values($0, cnt) }
		END { flush() }
	'
}

# Sum the merged ranges in $1, clipped to $2 bytes.
free_bytes() {
	sort -n -k1,1 -- "$1" | awk -v size="$2" '
		{
			s = $1; e = $2
			if (e > size) e = size
			if (s < last) s = last
			if (e > s) { total += e - s; last = e }
		}
		END { print total + 0 }
	'
}

# Bound case $2 of seed $1 (see --help): "free" when every changed byte
# lies in the seed's uncompressed sample ranges; "clean" when libtiff reads
# it with the seed's diagnostics and every Deflate stream it touches still
# passes Adler-32; else "open". A length change is open.
case_bound() {
	local seed="$1" mutated="$2" changed="$work/changed" start end
	if [ "$(wc -c <"$seed")" != "$(wc -c <"$mutated")" ]; then
		printf 'open\n'
		return
	fi
	cmp -l -- "$seed" "$mutated" 2>/dev/null | awk '{ print $1 - 1 }' >"$changed"
	if [ "$(within_ranges "${seed_ranges[$seed]}" <"$changed")" = all ]; then
		printf 'free\n'
		return
	fi
	if [ "$(libtiff_diag "$mutated")" != "${seed_diag[$seed]//"$seed"/@FILE}" ]; then
		printf 'open\n'
		return
	fi
	while read -r start end; do
		if ! zlib_ok "$mutated" "$start" "$end"; then
			printf 'open\n'
			return
		fi
	done < <(touched_ranges "${seed_zlib[$seed]}" <"$changed")
	printf 'clean\n'
}

# Offsets on stdin: print "all" when each lies in a range of file $1.
within_ranges() {
	awk -v ranges="$1" '
		BEGIN { n = 0; while ((getline line < ranges) > 0) { split(line, r, " "); s[n] = r[1]; e[n] = r[2]; n++ } }
		{
			hit = 0
			for (i = 0; i < n; i++) if ($1 >= s[i] && $1 < e[i]) { hit = 1; break }
			if (!hit) { out = 1; exit }
		}
		END { print (out ? "some" : "all") }
	'
}

# Offsets on stdin: print each range of file $1 that holds one, once.
touched_ranges() {
	awk -v ranges="$1" '
		BEGIN { n = 0; while ((getline line < ranges) > 0) { split(line, r, " "); s[n] = r[1]; e[n] = r[2]; n++ } }
		{ for (i = 0; i < n; i++) if ($1 >= s[i] && $1 < e[i]) hit[i] = 1 }
		END { for (i = 0; i < n; i++) if (hit[i]) print s[i], e[i] }
	'
}

classify_tiffz() {
	# $1 wait status, $2 JSON file, $3 unmutated seed path.
	local status="$1" json="$2" seed="$3"
	# 124 is timeout's status when the decoder did not finish.
	if [ "$status" -ge 128 ] || [ "$status" -eq 124 ]; then
		printf 'crash\n'
	elif [ "$status" -eq 1 ]; then
		printf 'detect\n'
	elif [ "$status" -eq 4 ]; then
		printf 'reach\n'
	elif [ "$status" -eq 0 ]; then
		local now base now16 base16
		now="$(non16_key "$json")"
		base="${seed_non16[$seed]:-}"
		now16="$(has_code16 "$json")"
		base16="${seed_code16[$seed]:-no}"
		if [ "$now" != "$base" ]; then
			printf 'detect\n'
		elif [ "$now16" != "$base16" ]; then
			printf 'reach\n'
		else
			printf 'accept\n'
		fi
	else
		printf 'harness\n'
	fi
}

score_batch() {
	# Append outcomes for one corruption-reader invocation.
	# $1 profile  $2 report  $3 path list  $4 reader exit  $5 outcome file  $6 seed
	local profile="$1" report="$2" pathfile="$3" reader_status="$4" out="$5" seed="$6"
	local line status noop emitted path
	if [ "$reader_status" -eq 2 ] || [ ! -s "$report" ]; then
		printf '%s\tharness\n' "$profile" >>"$out"
		return
	fi
	local -a paths=()
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		paths+=("$path")
	done <"$pathfile"
	local cursor=0
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		status="$(printf '%s\n' "$line" | json_field status)"
		noop="$(printf '%s\n' "$line" | json_field noop)"
		emitted="$(printf '%s\n' "$line" | json_field emitted)"
		if [ "$status" = "noop" ] || { [ -n "$noop" ] && [ "$noop" != "null" ]; }; then
			printf '%s\tnoop\n' "$profile" >>"$out"
			continue
		fi
		if [ "$emitted" != "true" ] || [ "$cursor" -ge "${#paths[@]}" ]; then
			printf '%s\tharness\n' "$profile" >>"$out"
			continue
		fi
		path="${paths[$cursor]}"
		cursor=$((cursor + 1))
		local tiffz_status=0
		local json="$work/tiffz.json"
		: >"$json"
		validate_limited "$path" "$json" || tiffz_status=$?
		local bound
		bound="$(case_bound "$seed" "$path")"
		rm -f -- "$path"
		classify_tiffz "$tiffz_status" "$json" "$seed" | awk -v profile="$profile" -v class="${seed_class[$seed]}" -v bound="$bound" \
			'{ printf "%s\t%s\t%s\t%s\n", profile, $0, class, bound }' >>"$out"
	done <"$report"
}

campaign() {
	local seeds nseeds target cap seed profile
	local accepted=0 rejected=0
	resolve_tools
	seeds="$(load_seeds)"
	if [ -z "$seeds" ]; then
		die "no seeds"
	fi
	nseeds="$(printf '%s\n' "$seeds" | awk 'NF { n++ } END { print n+0 }')"
	if [ -n "$trials" ]; then
		target="$trials"
	else
		target="$(worst_case_trials "$margin")" || die "margin must be in (0, 1]"
	fi
	case "$target" in
		''|*[!0-9]*) die "trials must be a positive integer" ;;
	esac
	if [ "$target" -lt 1 ]; then
		die "trials must be a positive integer"
	fi
	cap=$((target * 4))
	printf 'mutation_definition=validate-mutation-v3\n'
	printf 'shotgun_profile=shotgun_variable\n'
	printf 'master=%s margin=%.6f confidence=0.95 trials=%s\n' "$master" "$margin" "$target"
	printf 'reader=%s\n' "$("$cr_bin" --about 2>/dev/null || printf 'unknown\n')"
	printf 'tiffz=%s\n' "$tiffz_bin"

	while IFS= read -r seed; do
		[ -n "$seed" ] || continue
		local st=0
		if [ ! -f "$seed" ]; then
			rejected=$((rejected + 1))
			printf 'specificity reject %s missing\n' "$seed"
			continue
		fi
		local spec_json="$work/spec.json"
		: >"$spec_json"
		validate_limited "$seed" "$spec_json" || st=$?
		if [ "$st" -eq 0 ]; then
			local hash bytes
			hash="$(sha256sum -- "$seed" | awk '{ print $1 }')"
			bytes="$(wc -c <"$seed" | tr -d '[:space:]')"
			printf 'specificity sha256=%s bytes=%s\n' "$hash" "$bytes"
			seed_non16["$seed"]="$(non16_key "$spec_json")"
			seed_code16["$seed"]="$(has_code16 "$spec_json")"
			local ranges="$work/ranges.$accepted" zlib="$work/zlib.$accepted" class
			: >"$ranges"
			: >"$zlib"
			class="$(seed_layout "$seed" "$ranges" "$zlib")" || exit 2
			seed_class["$seed"]="$class"
			seed_ranges["$seed"]="$ranges"
			seed_zlib["$seed"]="$zlib"
			seed_diag["$seed"]="$(libtiff_diag "$seed")"
			printf 'layout %s class=%s free_bytes=%s bytes=%s\n' "$seed" "$class" "$(free_bytes "$ranges" "$bytes")" "$bytes"
			accepted=$((accepted + 1))
		else
			rejected=$((rejected + 1))
			printf 'specificity reject %s exit %s\n' "$seed" "$st"
		fi
	done <<EOF
$seeds
EOF
	printf 'specificity seeds=%s accepted=%s rejected=%s\n' "$nseeds" "$accepted" "$rejected"
	if [ "$rejected" -ne 0 ]; then
		return 1
	fi

	local ledger="$work/ledger"
	: >"$ledger"
	local overall=0
	for profile in "${profiles[@]}"; do
		local decisive=0 attempts=0 round_base=0
		local per
		if [ -n "$trials" ]; then
			per=$(((target + nseeds - 1) / nseeds))
		else
			# A pass across the corpus, then re-check the interval.
			per=$(((96 + nseeds - 1) / nseeds))
		fi
		if [ "$per" -lt 1 ]; then
			per=1
		fi
		local guard=0
		while [ "$decisive" -lt "$target" ] && [ "$attempts" -lt "$cap" ] && [ "$guard" -lt 100 ]; do
			guard=$((guard + 1))
			local before="$decisive"
			while IFS= read -r seed; do
				[ -n "$seed" ] || continue
				[ "$decisive" -lt "$target" ] || break
				[ "$attempts" -lt "$cap" ] || break
				local draw=$((target - decisive))
				if [ "$draw" -gt "$per" ]; then
					draw="$per"
				fi
				local room=$((cap - attempts))
				if [ "$draw" -gt "$room" ]; then
					draw="$room"
				fi
				if [ "$draw" -lt 1 ]; then
					break
				fi
				local batch="$work/batch"
				mkdir -p "$batch"
				local report="$batch/report.jsonl"
				local paths="$batch/paths"
				local reader_status=0
				local draw_profile
				draw_profile="$(reader_profile "$profile")"
				"$cr_bin" corrupt "$draw_profile" \
					--master "$master" \
					--round "$round_base" \
					--count "$draw" \
					--emit tmp \
					--tmp-dir "$batch" \
					--report "$report" \
					-- "$seed" >"$paths" 2>"$batch/reader.err" || reader_status=$?
				local before_lines
				before_lines="$(wc -l <"$ledger" | tr -d '[:space:]')"
				score_batch "$profile" "$report" "$paths" "$reader_status" "$ledger" "$seed"
				round_base=$((round_base + draw))
				attempts=$((attempts + draw))
				local added
				added="$(awk -v profile="$profile" -F '\t' '
					$1 == profile && ($2 == "detect" || $2 == "accept") { n++ }
					END { print n+0 }
				' "$ledger")"
				decisive="$added"
				rm -rf -- "$batch"
				# before_lines is only here so a failed batch is still visible in the ledger.
				: "$before_lines"
			done <<EOF
$seeds
EOF
			printf 'progress %s decisive=%s attempts=%s\n' "$profile" "$decisive" "$attempts" >&2
			if [ "$decisive" -eq "$before" ]; then
				break
			fi
			# Without a fixed --trials count, stop once the observed
			# interval is already within the margin.
			if [ -z "$trials" ] && [ "$decisive" -ge 1 ]; then
				local half_now
				half_now="$(awk -v profile="$profile" -F '\t' -v z="$z_95" '
					$1 == profile && $2 == "detect" { k++ }
					$1 == profile && $2 == "accept" { a++ }
					END {
						n = k + a
						if (n < 1) { print "na"; exit }
						z2 = z * z
						den = n + z2
						center = (k + z2 / 2) / den
						inner = (k * a / n) + z2 / 4
						if (inner < 0) inner = 0
						span = z / den * sqrt(inner)
						low = center - span
						high = center + span
						if (low < 0) low = 0
						if (high > 1) high = 1
						printf "%.10f\n", (high - low) / 2
					}
				' "$ledger")"
				if [ "$half_now" != "na" ] && awk -v half="$half_now" -v margin="$margin" 'BEGIN { exit !(half <= margin + 1e-12) }'; then
					break
				fi
			fi
		done
	done

	local summary_status=0
	summarize <"$ledger" || summary_status=$?
	if [ -n "$floors_file" ]; then
		check_floors "$ledger"
		return $?
	fi
	return "$summary_status"
}

# Read --floors: one "master=SEED trials=N" line and "PROFILE MIN" per profile.
# A master or trial count given on the command line must agree with it.
load_floors() {
	local line f_master="" f_trials="" profile
	[ -r "$floors_file" ] || die "cannot read floors file: $floors_file"
	while IFS= read -r line || [ -n "$line" ]; do
		line="${line%%#*}"
		line="${line#"${line%%[![:space:]]*}"}"
		line="${line%"${line##*[![:space:]]}"}"
		[ -n "$line" ] || continue
		if [[ "$line" =~ ^master=([^[:space:]]+)[[:space:]]+trials=([0-9]+)$ ]]; then
			f_master="${BASH_REMATCH[1]}"
			f_trials="${BASH_REMATCH[2]}"
		elif [[ "$line" =~ ^([a-z]+)[[:space:]]+([a-z]+)[[:space:]]+([0-9]+)$ ]]; then
			floor_min["${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"]="${BASH_REMATCH[3]}"
		else
			die "floors: cannot parse line: $line"
		fi
	done <"$floors_file"
	[ -n "$f_master" ] || die "floors: missing master=SEED trials=N line"
	if [ "$master_set" -eq 1 ] && [ "$master" != "$f_master" ]; then
		die "floors: --master $master disagrees with master=$f_master"
	fi
	if [ "$trials_set" -eq 1 ] && [ "$trials" != "$f_trials" ]; then
		die "floors: --trials $trials disagrees with trials=$f_trials"
	fi
	master="$f_master"
	trials="$f_trials"
	local class key
	for profile in "${profiles[@]}"; do
		for class in "${classes[@]}"; do
			[ -n "${floor_min[$profile $class]:-}" ] || die "floors: no floor for $profile $class"
		done
	done
	for key in "${!floor_min[@]}"; do
		case " ${profiles[*]} " in
			*" ${key% *} "*) ;;
			*) die "floors: unknown profile ${key% *}" ;;
		esac
		case " ${classes[*]} " in
			*" ${key#* } "*) ;;
			*) die "floors: unknown class ${key#* }" ;;
		esac
	done
}

# Print a "floor" line per profile (trials reached) and per profile and
# class (detections against the floor, false alarms). Exit 1 on any miss.
check_floors() {
	local ledger="$1" profile class status=0 line
	for profile in "${profiles[@]}"; do
		line="$(awk -v profile="$profile" -v want="$trials" -F '\t' '
			$1 == profile && ($2 == "detect" || $2 == "accept") { n++ }
			$1 == profile && ($2 == "crash" || $2 == "harness") { bad++ }
			END {
				verdict = "ok"
				if (bad > 0) verdict = "crash"
				else if (n < want) verdict = "short"
				printf "floor %s decisive=%d trials=%d %s\n", profile, n, want, verdict
			}
		' "$ledger")"
		printf '%s\n' "$line"
		case "$line" in *" ok") ;; *) status=1 ;; esac
		for class in "${classes[@]}"; do
			line="$(awk -v profile="$profile" -v class="$class" -v min="${floor_min[$profile $class]}" -F '\t' '
				$1 == profile && $3 == class && $2 == "detect" { k++; if ($4 == "free") fa++ }
				END {
					verdict = "ok"
					if (fa > 0) verdict = "false_alarm"
					else if (k < min) verdict = "below"
					printf "floor %s %s detect=%d min=%d false_alarm=%d %s\n", profile, class, k, min, fa, verdict
				}
			' "$ledger")"
			printf '%s\n' "$line"
			case "$line" in *" ok") ;; *) status=1 ;; esac
		done
	done
	return "$status"
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		-h|--help)
			usage
			exit 0
			;;
		--list-seeds)
			default_seeds
			exit 0
			;;
		--summarize)
			mode=summarize
			shift
			;;
		--margin)
			[ "$#" -ge 2 ] || die "--margin needs a value"
			margin="$2"
			shift 2
			;;
		--trials)
			[ "$#" -ge 2 ] || die "--trials needs a value"
			trials="$2"
			trials_set=1
			shift 2
			;;
		--master)
			[ "$#" -ge 2 ] || die "--master needs a value"
			master="$2"
			master_set=1
			shift 2
			;;
		--tiffz)
			[ "$#" -ge 2 ] || die "--tiffz needs a path"
			tiffz_bin="$2"
			shift 2
			;;
		--corruption-reader)
			[ "$#" -ge 2 ] || die "--corruption-reader needs a path"
			cr_bin="$2"
			shift 2
			;;
		--floors)
			[ "$#" -ge 2 ] || die "--floors needs a path"
			floors_file="$2"
			shift 2
			;;
		--tiffdump)
			[ "$#" -ge 2 ] || die "--tiffdump needs a path"
			tiffdump_bin="$2"
			shift 2
			;;
		--tiffinfo)
			[ "$#" -ge 2 ] || die "--tiffinfo needs a path"
			tiffinfo_bin="$2"
			shift 2
			;;
		--pigz)
			[ "$#" -ge 2 ] || die "--pigz needs a path"
			pigz_bin="$2"
			shift 2
			;;
		--seeds-file)
			[ "$#" -ge 2 ] || die "--seeds-file needs a path"
			seeds_file="$2"
			shift 2
			;;
		--)
			shift
			break
			;;
		*)
			die "unknown argument: $1"
			;;
	esac
done

if [ -n "$floors_file" ]; then
	load_floors
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/tiffz-corruption-coverage.XXXXXX")"
cleanup() {
	case "$work" in
		"${TMPDIR:-/tmp}"/tiffz-corruption-coverage.*) rm -rf -- "$work" ;;
	esac
}
trap cleanup EXIT

if [ "$mode" = "summarize" ]; then
	summarize
	exit $?
fi

campaign
exit $?

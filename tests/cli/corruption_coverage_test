#!/usr/bin/env bash
# Scorer and driver contract for ./corruption-coverage.
# Fakes stand in for corruption-reader and tiffz. No network, no real decoder.

set -u

root="$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)"
subject="$root/corruption-coverage"
failures=0
sandbox="$(mktemp -d "${TMPDIR:-/tmp}/tiffz-corruption-coverage.XXXXXX")"

cleanup() {
	case "$sandbox" in
		"${TMPDIR:-/tmp}"/tiffz-corruption-coverage.*) rm -rf -- "$sandbox" ;;
	esac
}
trap cleanup EXIT

fail() {
	printf 'FAIL: %s\n' "$1" >&2
	failures=$((failures + 1))
}

assert_equal() {
	local label="$1" expected="$2" actual="$3"
	if [ "$actual" != "$expected" ]; then
		fail "$label"
		printf '  expected: %q\n' "$expected" >&2
		printf '  actual:   %q\n' "$actual" >&2
	fi
}

assert_contains() {
	local label="$1" haystack="$2" needle="$3"
	if [[ "$haystack" != *"$needle"* ]]; then
		fail "$label"
		printf '  missing: %q\n' "$needle" >&2
	fi
}

assert_not_contains() {
	local label="$1" haystack="$2" needle="$3"
	if [[ "$haystack" == *"$needle"* ]]; then
		fail "$label"
		printf '  unexpected: %q\n' "$needle" >&2
	fi
}

run_subject() {
	local out="$sandbox/out" err="$sandbox/err"
	: >"$out"
	: >"$err"
	"$subject" "$@" >"$out" 2>"$err"
	subject_status=$?
	subject_out="$(cat "$out")"
	subject_err="$(cat "$err")"
}

# --- help and the known-good seed list ---------------------------------

if [ ! -x "$subject" ]; then
	fail "corruption-coverage is missing or not executable"
	printf '%d failure(s)\n' "$failures" >&2
	exit 1
fi

run_subject --help
assert_equal "--help exits 0" 0 "$subject_status"
assert_contains "--help names sniper" "$subject_out" "sniper"
assert_contains "--help names bolter" "$subject_out" "bolter"
assert_contains "--help names shotgun" "$subject_out" "shotgun"
assert_contains "--help names nuke" "$subject_out" "nuke"
assert_contains "--help names the 95% interval" "$subject_out" "Wilson"

run_subject --list-seeds
assert_equal "--list-seeds exits 0" 0 "$subject_status"
seed_count="$(printf '%s\n' "$subject_out" | awk 'NF { n++ } END { print n+0 }')"
zig_count="$(awk '
	/const seed_corpus/ { grab = 1; next }
	grab && /};/ { exit }
	grab && /"/ {
		line = $0
		while (match(line, /"[^"]+"/)) {
			n++
			line = substr(line, RSTART + RLENGTH)
		}
	}
	END { print n+0 }
' "$root/tests/fuzz/fuzz.zig")"
assert_equal "seed count matches tests/fuzz/fuzz.zig" "$zig_count" "$seed_count"
assert_contains "uncompressed seed is listed" "$subject_out" \
	"tests/fixtures/uncompressed/minisblack-1c-8b.tiff"
assert_contains "jpeg seed is listed" "$subject_out" \
	"tests/fixtures/jpeg/rgb-jpeg.tif"

# --- Wilson summary: reach and no-op stay out of the denominator --------

ledger="$sandbox/ledger"
{
	i=0
	while [ "$i" -lt 81 ]; do printf 'sniper\tdetect\n'; i=$((i + 1)); done
	i=0
	while [ "$i" -lt 19 ]; do printf 'sniper\taccept\n'; i=$((i + 1)); done
	i=0
	while [ "$i" -lt 7 ]; do printf 'sniper\treach\n'; i=$((i + 1)); done
	i=0
	while [ "$i" -lt 3 ]; do printf 'sniper\tnoop\n'; i=$((i + 1)); done
} >"$ledger"

run_subject --summarize --margin 0.08 <"$ledger"
assert_equal "81/100 summary exits 0" 0 "$subject_status"
assert_equal "81/100 summary is silent on stderr" "" "$subject_err"
assert_contains "81/100 Wilson line" "$subject_out" \
	"sniper decisive=100 detect=81 accept=19 reach=7 noop=3 crash=0 harness=0 rate=0.810000 low=0.722212 high=0.874852 half=0.076320 precise=yes"

printf 'sniper\tcrash\n' >"$ledger"
run_subject --summarize --margin 0.5 <"$ledger"
assert_equal "a crash is not a successful measurement" 1 "$subject_status"
assert_contains "crash is counted apart" "$subject_out" \
	"sniper decisive=0 detect=0 accept=0 reach=0 noop=0 crash=1 harness=0 rate=na low=na high=na half=na precise=no"

# --- end to end, with fakes ----------------------------------------------

bindir="$sandbox/bin"
mkdir -p "$bindir"
cat >"$bindir/corruption-reader" <<'EOF'
#!/usr/bin/env bash
set -u
if [ "${1:-}" = "--about" ]; then
	printf '%s (test/fake)\n' "${FAKE_ABOUT:-corruption-reader 0.0.0-fake: test}"
	exit 0
fi
if [ "${1:-}" = "profile" ] && [ "${2:-}" = "show" ]; then
	printf '{"name":"%s"%s}\n' "${3:-}" "${FAKE_PROFILE_SALT:+,\"salt\":$FAKE_PROFILE_SALT}"
	exit 0
fi
if [ "${1:-}" = "draw" ]; then
	printf '{"record":2,"rng":"%s","case_derivation":"fake case seed v1","round":0}\n' "${FAKE_RNG:-fake drbg v1}"
	exit 0
fi
log="${FAKE_READER_LOG:?}"
printf '%s\n' "$*" >>"$log"
profile=""
master=""
round=""
count=""
tmpdir=""
report=""
seed=""
prev=""
for arg in "$@"; do
	case "$prev" in
		--master) master="$arg" ;;
		--round) round="$arg" ;;
		--count) count="$arg" ;;
		--tmp-dir) tmpdir="$arg" ;;
		--report) report="$arg" ;;
	esac
	case "$arg" in
		--master|--round|--count|--tmp-dir|--report) prev="$arg"; continue ;;
	esac
	prev=""
	if [ "$arg" = "corrupt" ]; then
		expect_profile=1
		continue
	fi
	if [ "${expect_profile:-0}" = 1 ]; then
		profile="$arg"
		expect_profile=0
	fi
	case "$arg" in
		--*) ;;
		*) seed="$arg" ;;
	esac
done
if [ -z "$profile" ] || [ -z "$tmpdir" ] || [ -z "$report" ] || [ -z "$seed" ]; then
	printf 'fake reader: missing args\n' >&2
	exit 2
fi
: >"$report"
i=0
any_noop=0
while [ "$i" -lt "$count" ]; do
	r=$((round + i))
	if [ "$profile" = "nuke" ] && [ "${FAKE_MODE:-all-detect}" = "mixed" ]; then
		printf '{"report":1,"item":%d,"round":%d,"status":"noop","noop":"too_small","emitted":false,"record":{}}\n' \
			"$i" "$r" >>"$report"
		any_noop=1
	else
		out="$tmpdir/cr-${profile}-r${r}-fake.tiff"
		{ printf 'X'; tail -c +2 -- "$seed"; } >"$out"
		printf '%s\n' "$out"
		printf '{"report":1,"item":%d,"round":%d,"status":"applied","noop":null,"emitted":true,"record":{"profile":{"name":"%s"}}}\n' \
			"$i" "$r" "$profile" >>"$report"
	fi
	i=$((i + 1))
done
if [ "$any_noop" -eq 1 ]; then
	exit 3
fi
exit 0
EOF
cat >"$bindir/tiffz" <<'EOF'
#!/usr/bin/env bash
set -u
path=""
for arg in "$@"; do
	case "$arg" in
		--json|validate) ;;
		*) path="$arg" ;;
	esac
done
findings='[]'
case "$path" in
	*"/cr-sniper-"*) code=1 ;;
	*"/cr-bolter-"*) code=4 ;;
	*"/cr-shotgun-"*) code=0 ;;
	*"/cr-nuke-"*) code=1 ;;
	*)
		if [ "${FAKE_MODE:-all-detect}" = "reject-seed" ]; then
			code=1
		else
			code=0
		fi
		;;
esac
if [ "${FAKE_MODE:-all-detect}" = "finding" ]; then
	case "$path" in
		*"/cr-sniper-"*)
			code=0
			findings='[{"source":1,"code":13,"verdict":0}]'
			;;
		*"/cr-bolter-"*)
			code=0
			findings='[{"source":1,"code":16,"verdict":2}]'
			;;
	esac
fi
if [ "${FAKE_MODE:-all-detect}" = "all-detect" ]; then
	case "$path" in
		*"/cr-"*) code=1 ;;
	esac
fi
# FAKE_UNDETECT lists cases (e.g. "sniper-r3") that are accepted.
for miss in ${FAKE_UNDETECT:-}; do
	case "$path" in
		*"/cr-$miss-fake.tiff") code=0; findings='[]' ;;
	esac
done
printf '{"status":"fake","path":"%s","error":%d,"ifds":0,"findings":%s}\n' "$path" "$code" "$findings"
exit "$code"
EOF
chmod +x "$bindir/corruption-reader" "$bindir/tiffz"
cat >"$bindir/tiffdump" <<'EOF2'
#!/usr/bin/env bash
# Fake libtiff tiffdump: describes the seed per FAKE_LAYOUT. Like the real
# one, it shortens arrays with " ..." unless -m raises the item limit.
set -u
full=0
path=""
while [ "$#" -gt 0 ]; do
	case "$1" in
		-m) full=1; shift 2 ;;
		*) path="$1"; shift ;;
	esac
done
ifd() {
	# $1 directory  $2 compression  $3 offsets  $4 counts
	local n offs cnts
	n="$(printf '%s\n' "$3" | wc -w)"
	offs="$3"
	cnts="$4"
	if [ "$full" -eq 0 ] && [ "$n" -gt 1 ]; then
		offs="${3%% *} ..."
		cnts="${4%% *} ..."
	fi
	printf 'Directory %s: offset 8 (0x8) next 0 (0)\n' "$1"
	printf 'Compression (259) SHORT (3) 1<%s>\n' "$2"
	printf 'StripOffsets (273) LONG (4) %s<%s>\n' "$n" "$offs"
	printf 'StripByteCounts (279) LONG (4) %s<%s>\n' "$n" "$cnts"
}
if [ "${FAKE_LAYOUT:-deflate}" = broken ]; then
	printf '%s: Not a TIFF file\n' "$path" >&2
	exit 1
fi
printf '%s:\nMagic: 0x4949 <little-endian> Version: 0x2a <ClassicTIFF>\n' "$path"
case "${FAKE_LAYOUT:-deflate}" in
	uncompressed-all) ifd 0 1 0 3 ;;
	uncompressed-tail) ifd 0 1 2 1 ;;
	two-strips) ifd 0 1 "0 2" "1 1" ;;
	lzw) ifd 0 5 0 3 ;;
	deflate) ifd 0 8 0 3 ;;
	deflate-tail) ifd 0 8 2 1 ;;
	lerc) ifd 0 34887 0 3 ;;
	zstd) ifd 0 50000 0 6 ;;
	majority) ifd 0 1 2 1; ifd 1 5 0 2 ;;
	tie-unchecked) ifd 0 8 0 1; ifd 1 5 1 1 ;;
	tie-uncompressed) ifd 0 8 0 1; ifd 1 1 1 1 ;;
esac
EOF2
cat >"$bindir/tiffinfo" <<'EOF2'
#!/usr/bin/env bash
# Fake libtiff tiffinfo -D: the seed reads cleanly; a case reads per FAKE_LIBTIFF.
set -u
path="${!#}"
if [ "${FAKE_LIBTIFF:-clean}" = warn-always ]; then
	printf '%s: Warning, unknown field with tag 33550\n' "$path" >&2
	exit 0
fi
case "$path" in
	*"/cr-"*) mode="${FAKE_LIBTIFF:-clean}" ;;
	*) mode=clean ;;
esac
if [ "$mode" = error ]; then
	printf 'TIFFReadEncodedStrip: %s: Read error on strip 0\n' "$path" >&2
	exit 1
fi
exit 0
EOF2
cat >"$bindir/pigz" <<'EOF2'
#!/usr/bin/env bash
# Fake pigz -dc: with FAKE_PIGZ=mismatch, a stream the fake reader rewrote
# (first byte X) fails its Adler-32 check.
set -u
first="$(head -c 1)"
cat >/dev/null
if [ "${FAKE_PIGZ:-ok}" = mismatch ] && [ "$first" = X ]; then
	printf 'pigz: skipping: <stdin>: corrupted -- adler32 mismatch\n' >&2
	exit 1
fi
exit 0
EOF2
chmod +x "$bindir/tiffdump" "$bindir/tiffinfo" "$bindir/pigz"
export PATH="$bindir:$PATH"

seedfile="$sandbox/seeds"
printf '%s\n' "$sandbox/seed-a.tiff" >"$seedfile"
printf 'ok\n' >"$sandbox/seed-a.tiff"
export FAKE_READER_LOG="$sandbox/reader.log"
: >"$FAKE_READER_LOG"

FAKE_MODE=all-detect run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--master 42 \
	--trials 8 \
	--margin 0.20
assert_equal "all-detect measurement exits 0" 0 "$subject_status"
progress_stripped="$(printf '%s\n' "$subject_err" | awk '$1 != "progress" && NF')"
assert_equal "all-detect measurement is silent aside from progress" "" "$progress_stripped"
for profile in sniper bolter shotgun nuke; do
	assert_contains "$profile 8/8 is precise" "$subject_out" \
		"$profile decisive=8 detect=8 accept=0 reach=0 noop=0 crash=0 harness=0 rate=1.000000 low=0.675592 high=1.000000 half=0.162204 precise=yes"
done
assert_contains "master is recorded" "$subject_out" "master=42"
assert_contains "mutation definition is validate-mutation-v3" "$subject_out" "mutation_definition=validate-mutation-v3"
seed_hash="$(sha256sum "$sandbox/seed-a.tiff" | awk '{print $1}')"
assert_contains "specificity records the seed hash" "$subject_out" "sha256=$seed_hash"
assert_contains "specificity records the seed length" "$subject_out" "bytes=3"
assert_contains "shotgun draws the variable window" "$(cat "$FAKE_READER_LOG")" "corrupt shotgun_variable"
assert_not_contains "shotgun is not the fixed 16-bit profile" "$(cat "$FAKE_READER_LOG")" "corrupt shotgun "
assert_contains "reader was invoked" "$(cat "$FAKE_READER_LOG")" "--master 42"

: >"$FAKE_READER_LOG"
FAKE_MODE=reject-seed run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--master 42 \
	--trials 4 \
	--margin 0.20
assert_equal "rejected seed stops the measurement" 1 "$subject_status"
assert_contains "specificity names the reject" "$subject_out" "specificity"
assert_equal "no corruption is drawn after a rejected seed" "" "$(cat "$FAKE_READER_LOG")"

FAKE_MODE=mixed run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--master 42 \
	--trials 8 \
	--margin 0.20
assert_equal "mixed measurement is not precise for every profile" 1 "$subject_status"
assert_contains "sniper detections" "$subject_out" \
	"sniper decisive=8 detect=8 accept=0 reach=0 noop=0 crash=0 harness=0"
assert_contains "bolter is reach, not a detection" "$subject_out" \
	"bolter decisive=0 detect=0 accept=0 reach=8 noop=0 crash=0 harness=0 rate=na"
assert_contains "shotgun accepts are misses" "$subject_out" \
	"shotgun decisive=8 detect=0 accept=8 reach=0 noop=0 crash=0 harness=0 rate=0.000000 low=0.000000 high=0.324408 half=0.162204 precise=yes"
assert_contains "nuke no-op is not a trial" "$subject_out" \
	"nuke decisive=0 detect=0 accept=0 reach=0 noop=8 crash=0 harness=0 rate=na"

: >"$FAKE_READER_LOG"
FAKE_MODE=finding run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--master 42 \
	--trials 4 \
	--margin 0.20
assert_equal "a finding on exit 0 is not a clean measurement" 1 "$subject_status"
assert_contains "a new non-reach finding is a detection" "$subject_out" \
	"sniper decisive=4 detect=4 accept=0 reach=0 noop=0 crash=0 harness=0"
assert_contains "finding 16 alone is reach" "$subject_out" \
	"bolter decisive=0 detect=0 accept=0 reach=4 noop=0 crash=0 harness=0 rate=na"

# --- ceilings: oracles independent of tiffz ----------------------------
#
# The fake tiffdump describes the one seed ("ok\n", 3 bytes). The fake
# reader always rewrites byte 0. Each case is bounded three ways:
#   free   every changed byte is an uncompressed sample, so the file is
#          still valid and no validator can tell (a detection is a false
#          alarm);
#   clean  libtiff reads the case with the seed's own diagnostics, and any
#          touched checksummed stream still passes its own check, so it is
#          probably undetectable (a detection is stricter than libtiff);
#   open   everything else.
# ceiling counts only free cases and is an upper bound; ceiling_est also
# removes clean cases and is an estimate.

cov_args=(--tiffz "$bindir/tiffz" --corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" --master 42 --trials 2 --margin 0.20)

FAKE_MODE=all-detect FAKE_LAYOUT=uncompressed-all run_subject "${cov_args[@]}"
assert_contains "layout line for an all-sample seed" "$subject_out" \
	"layout $sandbox/seed-a.tiff class=uncompressed free_bytes=3 bytes=3"
assert_contains "a change inside sample bytes lowers the ceiling" "$subject_out" \
	"class sniper uncompressed decisive=2 detect=2 free=2 clean=0 ceiling=0.000000 ceiling_est=0.000000 open_rate=na false_alarm=2 stricter=0"
assert_contains "an empty unchecked class still prints" "$subject_out" \
	"class sniper unchecked decisive=0 detect=0 free=0 clean=0 ceiling=na ceiling_est=na open_rate=na false_alarm=0 stricter=0"
assert_contains "an empty checksummed class still prints" "$subject_out" \
	"class sniper checksummed decisive=0 detect=0 free=0 clean=0 ceiling=na ceiling_est=na open_rate=na false_alarm=0 stricter=0"
assert_contains "worst and best cases are named per profile" "$subject_out" \
	"ceilings sniper worst_case=uncompressed ceiling=0.000000 ceiling_est=0.000000 best_case=checksummed ceiling=na ceiling_est=na"

FAKE_MODE=all-detect FAKE_LAYOUT=uncompressed-tail FAKE_LIBTIFF=error run_subject \
	--tiffdump "$bindir/tiffdump" --tiffinfo "$bindir/tiffinfo" "${cov_args[@]}"
assert_contains "layout line counts only sample bytes" "$subject_out" \
	"layout $sandbox/seed-a.tiff class=uncompressed free_bytes=1 bytes=3"
assert_contains "a change libtiff rejects stays detectable" "$subject_out" \
	"class sniper uncompressed decisive=2 detect=2 free=0 clean=0 ceiling=1.000000 ceiling_est=1.000000 open_rate=1.000000 false_alarm=0 stricter=0"

FAKE_MODE=all-detect FAKE_LAYOUT=uncompressed-tail run_subject "${cov_args[@]}"
assert_contains "a structural change libtiff reads cleanly is probably free" "$subject_out" \
	"class sniper uncompressed decisive=2 detect=2 free=0 clean=2 ceiling=1.000000 ceiling_est=0.000000 open_rate=na false_alarm=0 stricter=2"

FAKE_MODE=all-detect FAKE_LAYOUT=uncompressed-tail FAKE_LIBTIFF=warn-always run_subject "${cov_args[@]}"
assert_contains "a diagnostic the seed also raises is not a difference" "$subject_out" \
	"class sniper uncompressed decisive=2 detect=2 free=0 clean=2"

FAKE_MODE=all-detect FAKE_LAYOUT=two-strips run_subject "${cov_args[@]}"
assert_contains "every strip is mapped, not tiffdump's first few" "$subject_out" \
	"layout $sandbox/seed-a.tiff class=uncompressed free_bytes=2 bytes=3"

FAKE_MODE=mixed FAKE_LAYOUT=lzw FAKE_LIBTIFF=error run_subject "${cov_args[@]}"
assert_contains "a codec without a check is unchecked" "$subject_out" \
	"layout $sandbox/seed-a.tiff class=unchecked free_bytes=0 bytes=3"
assert_contains "unchecked misses libtiff rejects count against the open rate" "$subject_out" \
	"class shotgun unchecked decisive=2 detect=0 free=0 clean=0 ceiling=1.000000 ceiling_est=1.000000 open_rate=0.000000 false_alarm=0 stricter=0"

FAKE_MODE=mixed FAKE_LAYOUT=lzw run_subject "${cov_args[@]}"
assert_contains "an unchecked stream libtiff decodes cleanly is probably free" "$subject_out" \
	"class shotgun unchecked decisive=2 detect=0 free=0 clean=2 ceiling=1.000000 ceiling_est=0.000000 open_rate=na false_alarm=0 stricter=0"

FAKE_MODE=all-detect FAKE_LAYOUT=deflate FAKE_PIGZ=mismatch run_subject "${cov_args[@]}"
assert_contains "Deflate is checksummed" "$subject_out" \
	"layout $sandbox/seed-a.tiff class=checksummed free_bytes=0 bytes=3"
assert_contains "a failed Adler-32 is detectable even when libtiff reads cleanly" "$subject_out" \
	"class sniper checksummed decisive=2 detect=2 free=0 clean=0 ceiling=1.000000 ceiling_est=1.000000 open_rate=1.000000 false_alarm=0 stricter=0"
assert_contains "the best case is the checksummed class" "$subject_out" \
	"ceilings sniper worst_case=uncompressed ceiling=na ceiling_est=na best_case=checksummed ceiling=1.000000 ceiling_est=1.000000"

FAKE_MODE=all-detect FAKE_LAYOUT=deflate run_subject "${cov_args[@]}"
assert_contains "a stream that still passes Adler-32 and libtiff is probably free" "$subject_out" \
	"class sniper checksummed decisive=2 detect=2 free=0 clean=2"

FAKE_MODE=all-detect FAKE_LAYOUT=deflate-tail FAKE_PIGZ=mismatch run_subject "${cov_args[@]}"
assert_contains "a change outside the stream does not consult its checksum" "$subject_out" \
	"class sniper checksummed decisive=2 detect=2 free=0 clean=2"

FAKE_MODE=all-detect FAKE_LAYOUT=lerc run_subject "${cov_args[@]}"
assert_contains "LERC is checksummed" "$subject_out" \
	"layout $sandbox/seed-a.tiff class=checksummed free_bytes=0 bytes=3"

FAKE_MODE=all-detect FAKE_LAYOUT=majority FAKE_LIBTIFF=error run_subject "${cov_args[@]}"
assert_contains "a seed is classed by the codec holding most data bytes" "$subject_out" \
	"layout $sandbox/seed-a.tiff class=unchecked free_bytes=1 bytes=3"
FAKE_MODE=all-detect FAKE_LAYOUT=tie-unchecked run_subject "${cov_args[@]}"
assert_contains "a tie takes the weaker class (unchecked)" "$subject_out" "class=unchecked"
FAKE_MODE=all-detect FAKE_LAYOUT=tie-uncompressed run_subject "${cov_args[@]}"
assert_contains "a tie takes the weaker class (uncompressed)" "$subject_out" "class=uncompressed"

zseeds="$sandbox/zseeds"
printf '%s\n' "$sandbox/seed-z.tiff" >"$zseeds"
printf '\050\265\057\375\140\000' >"$sandbox/seed-z.tiff"
FAKE_MODE=all-detect FAKE_LAYOUT=zstd run_subject "${cov_args[@]}" --seeds-file "$zseeds"
assert_contains "a Zstd frame without a content checksum is unchecked" "$subject_out" \
	"layout $sandbox/seed-z.tiff class=unchecked free_bytes=0 bytes=6"
printf '\050\265\057\375\144\000' >"$sandbox/seed-z.tiff"
FAKE_MODE=all-detect FAKE_LAYOUT=zstd run_subject "${cov_args[@]}" --seeds-file "$zseeds"
assert_equal "a checksummed Zstd frame has no independent oracle yet" 2 "$subject_status"
assert_contains "the refusal says why" "$subject_err" "Zstd content checksum"

FAKE_LAYOUT=broken run_subject "${cov_args[@]}"
assert_equal "a seed tiffdump cannot read stops the measurement" 2 "$subject_status"
assert_contains "the unreadable seed is named" "$subject_err" "seed-a.tiff"

# --- floors: the exact set of detected cases, over a pinned draw plan ----
# One seed and --trials 8, so each profile's plan is one batch of rounds
# 0..7. FAKE_UNDETECT names cases the fake tiffz accepts.

cases="$sandbox/cases"
floor_tools=(--tiffz "$bindir/tiffz" --corruption-reader "$bindir/corruption-reader" --seeds-file "$seedfile")
seed_a="$sandbox/seed-a.tiff"
tab="$(printf '\t')"

FAKE_MODE=all-detect FAKE_LAYOUT=uncompressed-tail FAKE_UNDETECT="sniper-r5" run_subject \
	"${floor_tools[@]}" --master 42 --trials 8 --floors "$cases" --write-floors
assert_equal "--write-floors starts a new case set" 0 "$subject_status"
assert_contains "the write names the file and case count" "$subject_out" "wrote $cases: 31 cases"
assert_contains "the write prints each cell" "$subject_out" "cell sniper uncompressed old=0 new=7"
case_file="$(cat "$cases" 2>/dev/null)"
assert_contains "the file says it is tool-written" "$case_file" "Never edit by hand"
assert_contains "the file pins the master" "$case_file" "master${tab}42"
assert_contains "the file pins the trial count" "$case_file" "trials${tab}8"
assert_contains "the file pins the generator version and revision" "$case_file" \
	"generator${tab}corruption-reader 0.0.0-fake: test${tab}unpinned"

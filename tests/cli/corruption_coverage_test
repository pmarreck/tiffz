#!/usr/bin/env bash
# Scorer and driver contract for ./corruption-coverage.
# Fakes stand in for corruption-reader and tiffz. No network, no real decoder.

set -u

root="$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)"
subject="$root/corruption-coverage"
failures=0
sandbox="$(mktemp -d "${TMPDIR:-/tmp}/tiffz-corruption-coverage.XXXXXX")"

cleanup() {
	case "$sandbox" in
		"${TMPDIR:-/tmp}"/tiffz-corruption-coverage.*) rm -rf -- "$sandbox" ;;
	esac
}
trap cleanup EXIT

fail() {
	printf 'FAIL: %s\n' "$1" >&2
	failures=$((failures + 1))
}

assert_equal() {
	local label="$1" expected="$2" actual="$3"
	if [ "$actual" != "$expected" ]; then
		fail "$label"
		printf '  expected: %q\n' "$expected" >&2
		printf '  actual:   %q\n' "$actual" >&2
	fi
}

assert_contains() {
	local label="$1" haystack="$2" needle="$3"
	if [[ "$haystack" != *"$needle"* ]]; then
		fail "$label"
		printf '  missing: %q\n' "$needle" >&2
	fi
}

assert_not_contains() {
	local label="$1" haystack="$2" needle="$3"
	if [[ "$haystack" == *"$needle"* ]]; then
		fail "$label"
		printf '  unexpected: %q\n' "$needle" >&2
	fi
}

run_subject() {
	local out="$sandbox/out" err="$sandbox/err"
	: >"$out"
	: >"$err"
	"$subject" "$@" >"$out" 2>"$err"
	subject_status=$?
	subject_out="$(cat "$out")"
	subject_err="$(cat "$err")"
}

# --- help and the known-good seed list ---------------------------------

if [ ! -x "$subject" ]; then
	fail "corruption-coverage is missing or not executable"
	printf '%d failure(s)\n' "$failures" >&2
	exit 1
fi

run_subject --help
assert_equal "--help exits 0" 0 "$subject_status"
assert_contains "--help names sniper" "$subject_out" "sniper"
assert_contains "--help names bolter" "$subject_out" "bolter"
assert_contains "--help names shotgun" "$subject_out" "shotgun"
assert_contains "--help names nuke" "$subject_out" "nuke"
assert_contains "--help names the 95% interval" "$subject_out" "Wilson"

run_subject --list-seeds
assert_equal "--list-seeds exits 0" 0 "$subject_status"
seed_count="$(printf '%s\n' "$subject_out" | awk 'NF { n++ } END { print n+0 }')"
zig_count="$(awk '
	/const seed_corpus/ { grab = 1; next }
	grab && /};/ { exit }
	grab && /"/ {
		line = $0
		while (match(line, /"[^"]+"/)) {
			n++
			line = substr(line, RSTART + RLENGTH)
		}
	}
	END { print n+0 }
' "$root/tests/fuzz/fuzz.zig")"
assert_equal "seed count matches tests/fuzz/fuzz.zig" "$zig_count" "$seed_count"
assert_contains "uncompressed seed is listed" "$subject_out" \
	"tests/fixtures/uncompressed/minisblack-1c-8b.tiff"
assert_contains "jpeg seed is listed" "$subject_out" \
	"tests/fixtures/jpeg/rgb-jpeg.tif"

# --- Wilson summary: reach and no-op stay out of the denominator --------

ledger="$sandbox/ledger"
{
	i=0
	while [ "$i" -lt 81 ]; do printf 'sniper\tdetect\n'; i=$((i + 1)); done
	i=0
	while [ "$i" -lt 19 ]; do printf 'sniper\taccept\n'; i=$((i + 1)); done
	i=0
	while [ "$i" -lt 7 ]; do printf 'sniper\treach\n'; i=$((i + 1)); done
	i=0
	while [ "$i" -lt 3 ]; do printf 'sniper\tnoop\n'; i=$((i + 1)); done
} >"$ledger"

run_subject --summarize --margin 0.08 <"$ledger"
assert_equal "81/100 summary exits 0" 0 "$subject_status"
assert_equal "81/100 summary is silent on stderr" "" "$subject_err"
assert_contains "81/100 Wilson line" "$subject_out" \
	"sniper decisive=100 detect=81 accept=19 reach=7 noop=3 crash=0 harness=0 rate=0.810000 low=0.722212 high=0.874852 half=0.076320 precise=yes"

printf 'sniper\tcrash\n' >"$ledger"
run_subject --summarize --margin 0.5 <"$ledger"
assert_equal "a crash is not a successful measurement" 1 "$subject_status"
assert_contains "crash is counted apart" "$subject_out" \
	"sniper decisive=0 detect=0 accept=0 reach=0 noop=0 crash=1 harness=0 rate=na low=na high=na half=na precise=no"

# --- end to end, with fakes ----------------------------------------------

bindir="$sandbox/bin"
mkdir -p "$bindir"
cat >"$bindir/corruption-reader" <<'EOF'
#!/usr/bin/env bash
set -u
if [ "${1:-}" = "--about" ]; then
	printf 'corruption-reader 0.0.0-fake (test)\n'
	exit 0
fi
log="${FAKE_READER_LOG:?}"
printf '%s\n' "$*" >>"$log"
profile=""
master=""
round=""
count=""
tmpdir=""
report=""
seed=""
prev=""
for arg in "$@"; do
	case "$prev" in
		--master) master="$arg" ;;
		--round) round="$arg" ;;
		--count) count="$arg" ;;
		--tmp-dir) tmpdir="$arg" ;;
		--report) report="$arg" ;;
	esac
	case "$arg" in
		--master|--round|--count|--tmp-dir|--report) prev="$arg"; continue ;;
	esac
	prev=""
	if [ "$arg" = "corrupt" ]; then
		expect_profile=1
		continue
	fi
	if [ "${expect_profile:-0}" = 1 ]; then
		profile="$arg"
		expect_profile=0
	fi
	case "$arg" in
		--*) ;;
		*) seed="$arg" ;;
	esac
done
if [ -z "$profile" ] || [ -z "$tmpdir" ] || [ -z "$report" ] || [ -z "$seed" ]; then
	printf 'fake reader: missing args\n' >&2
	exit 2
fi
: >"$report"
i=0
any_noop=0
while [ "$i" -lt "$count" ]; do
	r=$((round + i))
	if [ "$profile" = "nuke" ] && [ "${FAKE_MODE:-all-detect}" = "mixed" ]; then
		printf '{"report":1,"item":%d,"round":%d,"status":"noop","noop":"too_small","emitted":false,"record":{}}\n' \
			"$i" "$r" >>"$report"
		any_noop=1
	else
		out="$tmpdir/cr-${profile}-r${r}-fake.tiff"
		{ printf 'X'; tail -c +2 -- "$seed"; } >"$out"
		printf '%s\n' "$out"
		printf '{"report":1,"item":%d,"round":%d,"status":"applied","noop":null,"emitted":true,"record":{"profile":{"name":"%s"}}}\n' \
			"$i" "$r" "$profile" >>"$report"
	fi
	i=$((i + 1))
done
if [ "$any_noop" -eq 1 ]; then
	exit 3
fi
exit 0
EOF
cat >"$bindir/tiffz" <<'EOF'
#!/usr/bin/env bash
set -u
path=""
for arg in "$@"; do
	case "$arg" in
		--json|validate) ;;
		*) path="$arg" ;;
	esac
done
findings='[]'
case "$path" in
	*"/cr-sniper-"*) code=1 ;;
	*"/cr-bolter-"*) code=4 ;;
	*"/cr-shotgun-"*) code=0 ;;
	*"/cr-nuke-"*) code=1 ;;
	*)
		if [ "${FAKE_MODE:-all-detect}" = "reject-seed" ]; then
			code=1
		else
			code=0
		fi
		;;
esac
if [ "${FAKE_MODE:-all-detect}" = "finding" ]; then
	case "$path" in
		*"/cr-sniper-"*)
			code=0
			findings='[{"source":1,"code":13,"verdict":0}]'
			;;
		*"/cr-bolter-"*)
			code=0
			findings='[{"source":1,"code":16,"verdict":2}]'
			;;
	esac
fi
if [ "${FAKE_MODE:-all-detect}" = "all-detect" ]; then
	case "$path" in
		*"/cr-"*) code=1 ;;
	esac
fi
printf '{"status":"fake","path":"%s","error":%d,"ifds":0,"findings":%s}\n' "$path" "$code" "$findings"
exit "$code"
EOF
chmod +x "$bindir/corruption-reader" "$bindir/tiffz"
cat >"$bindir/tiffdump" <<'EOF'
#!/usr/bin/env bash
# Fake libtiff tiffdump: describes the 3-byte seed per FAKE_LAYOUT.
set -u
case "${FAKE_LAYOUT:-compressed}" in
	uncompressed-all) comp=1 off=0 cnt=3 ;;
	uncompressed-tail) comp=1 off=2 cnt=1 ;;
	compressed) comp=8 off=0 cnt=3 ;;
	broken)
		printf '%s: Not a TIFF file\n' "$1" >&2
		exit 1
		;;
esac
printf '%s:\nMagic: 0x4949 <little-endian> Version: 0x2a <ClassicTIFF>\n' "$1"
printf 'Directory 0: offset 8 (0x8) next 0 (0)\n'
printf 'Compression (259) SHORT (3) 1<%s>\n' "$comp"
printf 'StripOffsets (273) LONG (4) 1<%s>\n' "$off"
printf 'StripByteCounts (279) LONG (4) 1<%s>\n' "$cnt"
EOF
chmod +x "$bindir/tiffdump"
export PATH="$bindir:$PATH"

seedfile="$sandbox/seeds"
printf '%s\n' "$sandbox/seed-a.tiff" >"$seedfile"
printf 'ok\n' >"$sandbox/seed-a.tiff"
export FAKE_READER_LOG="$sandbox/reader.log"
: >"$FAKE_READER_LOG"

FAKE_MODE=all-detect run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--master 42 \
	--trials 8 \
	--margin 0.20
assert_equal "all-detect measurement exits 0" 0 "$subject_status"
progress_stripped="$(printf '%s\n' "$subject_err" | awk '$1 != "progress" && NF')"
assert_equal "all-detect measurement is silent aside from progress" "" "$progress_stripped"
for profile in sniper bolter shotgun nuke; do
	assert_contains "$profile 8/8 is precise" "$subject_out" \
		"$profile decisive=8 detect=8 accept=0 reach=0 noop=0 crash=0 harness=0 rate=1.000000 low=0.675592 high=1.000000 half=0.162204 precise=yes"
done
assert_contains "master is recorded" "$subject_out" "master=42"
assert_contains "mutation definition is validate-mutation-v3" "$subject_out" "mutation_definition=validate-mutation-v3"
seed_hash="$(sha256sum "$sandbox/seed-a.tiff" | awk '{print $1}')"
assert_contains "specificity records the seed hash" "$subject_out" "sha256=$seed_hash"
assert_contains "specificity records the seed length" "$subject_out" "bytes=3"
assert_contains "shotgun draws the variable window" "$(cat "$FAKE_READER_LOG")" "corrupt shotgun_variable"
assert_not_contains "shotgun is not the fixed 16-bit profile" "$(cat "$FAKE_READER_LOG")" "corrupt shotgun "
assert_contains "reader was invoked" "$(cat "$FAKE_READER_LOG")" "--master 42"

: >"$FAKE_READER_LOG"
FAKE_MODE=reject-seed run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--master 42 \
	--trials 4 \
	--margin 0.20
assert_equal "rejected seed stops the measurement" 1 "$subject_status"
assert_contains "specificity names the reject" "$subject_out" "specificity"
assert_equal "no corruption is drawn after a rejected seed" "" "$(cat "$FAKE_READER_LOG")"

FAKE_MODE=mixed run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--master 42 \
	--trials 8 \
	--margin 0.20
assert_equal "mixed measurement is not precise for every profile" 1 "$subject_status"
assert_contains "sniper detections" "$subject_out" \
	"sniper decisive=8 detect=8 accept=0 reach=0 noop=0 crash=0 harness=0"
assert_contains "bolter is reach, not a detection" "$subject_out" \
	"bolter decisive=0 detect=0 accept=0 reach=8 noop=0 crash=0 harness=0 rate=na"
assert_contains "shotgun accepts are misses" "$subject_out" \
	"shotgun decisive=8 detect=0 accept=8 reach=0 noop=0 crash=0 harness=0 rate=0.000000 low=0.000000 high=0.324408 half=0.162204 precise=yes"
assert_contains "nuke no-op is not a trial" "$subject_out" \
	"nuke decisive=0 detect=0 accept=0 reach=0 noop=8 crash=0 harness=0 rate=na"

: >"$FAKE_READER_LOG"
FAKE_MODE=finding run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--master 42 \
	--trials 4 \
	--margin 0.20
assert_equal "a finding on exit 0 is not a clean measurement" 1 "$subject_status"
assert_contains "a new non-reach finding is a detection" "$subject_out" \
	"sniper decisive=4 detect=4 accept=0 reach=0 noop=0 crash=0 harness=0"
assert_contains "finding 16 alone is reach" "$subject_out" \
	"bolter decisive=0 detect=0 accept=0 reach=4 noop=0 crash=0 harness=0 rate=na"

# --- ceilings: an oracle independent of tiffz --------------------------
#
# The fake tiffdump describes the one seed ("ok\n", 3 bytes). The fake
# reader always rewrites byte 0. A change confined to uncompressed sample
# bytes is undetectable by any validator, so it lowers the ceiling, and a
# detection of it is a false alarm.

FAKE_MODE=all-detect FAKE_LAYOUT=uncompressed-all run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--master 42 --trials 8 --margin 0.20
assert_contains "layout line for an all-sample seed" "$subject_out" \
	"layout $sandbox/seed-a.tiff class=uncompressed free_bytes=3 bytes=3"
assert_contains "a change inside sample bytes lowers the ceiling" "$subject_out" \
	"class sniper uncompressed decisive=8 detect=8 free=8 ceiling=0.000000 open_rate=na false_alarm=8"
assert_contains "an empty class still prints" "$subject_out" \
	"class sniper compressed decisive=0 detect=0 free=0 ceiling=na open_rate=na false_alarm=0"

FAKE_MODE=all-detect FAKE_LAYOUT=uncompressed-tail run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--tiffdump "$bindir/tiffdump" \
	--seeds-file "$seedfile" \
	--master 42 --trials 8 --margin 0.20
assert_contains "layout line counts only sample bytes" "$subject_out" \
	"layout $sandbox/seed-a.tiff class=uncompressed free_bytes=1 bytes=3"
assert_contains "a change outside sample bytes stays detectable" "$subject_out" \
	"class sniper uncompressed decisive=8 detect=8 free=0 ceiling=1.000000 open_rate=1.000000 false_alarm=0"

FAKE_MODE=mixed FAKE_LAYOUT=compressed run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--master 42 --trials 8 --margin 0.20
assert_contains "compressed seeds have no free sample bytes" "$subject_out" \
	"layout $sandbox/seed-a.tiff class=compressed free_bytes=0 bytes=3"
assert_contains "compressed misses count against the open rate" "$subject_out" \
	"class shotgun compressed decisive=8 detect=0 free=0 ceiling=1.000000 open_rate=0.000000 false_alarm=0"

FAKE_LAYOUT=broken run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--master 42 --trials 8 --margin 0.20
assert_equal "a seed tiffdump cannot read stops the measurement" 2 "$subject_status"
assert_contains "the unreadable seed is named" "$subject_err" "seed-a.tiff"

# --- floors: a regression gate over a pinned, deterministic campaign ------

floors="$sandbox/floors"
cat >"$floors" <<'EOF'
# comment lines and blank lines are ignored

master=42 trials=8
sniper uncompressed 8
sniper compressed 0
bolter uncompressed 0
bolter compressed 0
shotgun uncompressed 0
shotgun compressed 0
nuke uncompressed 0
nuke compressed 0
EOF

FAKE_MODE=all-detect FAKE_LAYOUT=uncompressed-tail run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--floors "$floors"
assert_equal "floors met exits 0" 0 "$subject_status"
assert_contains "floors take master from the file" "$subject_out" "master=42"
assert_contains "floors take trials from the file" "$subject_out" "trials=8"
assert_contains "sniper trial line" "$subject_out" "floor sniper decisive=8 trials=8 ok"
assert_contains "sniper class floor line" "$subject_out" \
	"floor sniper uncompressed detect=8 min=8 false_alarm=0 ok"
assert_contains "nuke compressed floor line" "$subject_out" \
	"floor nuke compressed detect=0 min=0 false_alarm=0 ok"

FAKE_MODE=finding FAKE_LAYOUT=uncompressed-tail run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--floors "$floors"
assert_equal "a short profile fails the floors" 1 "$subject_status"
assert_contains "bolter all reach is short of its trials" "$subject_out" \
	"floor bolter decisive=0 trials=8 short"

sed 's/^shotgun uncompressed 0$/shotgun uncompressed 1/' "$floors" >"$floors.high"
FAKE_MODE=mixed FAKE_LAYOUT=uncompressed-tail run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--floors "$floors.high"
assert_equal "detections below a floor fail" 1 "$subject_status"
assert_contains "shotgun below its floor" "$subject_out" \
	"floor shotgun uncompressed detect=0 min=1 false_alarm=0 below"
assert_contains "sniper still meets its floor" "$subject_out" \
	"floor sniper uncompressed detect=8 min=8 false_alarm=0 ok"

FAKE_MODE=all-detect FAKE_LAYOUT=uncompressed-all run_subject \
	--tiffz "$bindir/tiffz" \
	--corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile" \
	--floors "$floors"
assert_equal "a false alarm fails the floors" 1 "$subject_status"
assert_contains "the false alarm is named" "$subject_out" \
	"floor sniper uncompressed detect=8 min=8 false_alarm=8 false_alarm"

run_subject --floors "$floors" --trials 9 \
	--tiffz "$bindir/tiffz" --corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile"
assert_equal "trials that disagree with the floors file are a usage error" 2 "$subject_status"
assert_contains "the disagreement is named" "$subject_err" "trials"

run_subject --floors "$floors" --master 7 \
	--tiffz "$bindir/tiffz" --corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile"
assert_equal "a master that disagrees with the floors file is a usage error" 2 "$subject_status"

grep -v '^nuke compressed' "$floors" >"$floors.partial"
run_subject --floors "$floors.partial" \
	--tiffz "$bindir/tiffz" --corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile"
assert_equal "a floors file missing a profile and class is a usage error" 2 "$subject_status"
assert_contains "the missing pair is named" "$subject_err" "nuke compressed"

sed 's/^sniper uncompressed 8$/sniper uncompressed eight/' "$floors" >"$floors.bad"
run_subject --floors "$floors.bad" \
	--tiffz "$bindir/tiffz" --corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile"
assert_equal "a non-numeric floor is a usage error" 2 "$subject_status"

sed 's/^sniper compressed 0$/sniper lossless 0/' "$floors" >"$floors.class"
run_subject --floors "$floors.class" \
	--tiffz "$bindir/tiffz" --corruption-reader "$bindir/corruption-reader" \
	--seeds-file "$seedfile"
assert_equal "an unknown class is a usage error" 2 "$subject_status"

# --- default tiffz lookup: bin/<PF>/tiffz, never the retired zig-out/bin --

lookup="$sandbox/lookup project"
pf="$("$root/tools/pf")"
mkdir -p "$lookup/tools" "$lookup/bin/$pf" "$lookup/zig-out/bin"
cp -- "$subject" "$lookup/corruption-coverage"
cp -- "$root/tools/pf" "$lookup/tools/pf"
cp -- "$bindir/tiffz" "$lookup/bin/$pf/tiffz"
printf '#!/bin/sh\nexit 99\n' >"$lookup/zig-out/bin/tiffz"
chmod +x "$lookup/zig-out/bin/tiffz"
lookup_args=(--corruption-reader "$bindir/corruption-reader" --seeds-file "$seedfile" --trials 1)
TIFFZ="" "$lookup/corruption-coverage" "${lookup_args[@]}" >"$sandbox/out" 2>"$sandbox/err"
assert_contains "default tiffz is bin/<PF>/tiffz" "$(cat "$sandbox/out")" \
	"tiffz=$lookup/bin/$pf/tiffz"
mv -- "$lookup/bin/$pf/tiffz" "$lookup/bin/$pf/tiffz.moved"
TIFFZ="" "$lookup/corruption-coverage" "${lookup_args[@]}" >"$sandbox/out" 2>"$sandbox/err"
assert_contains "without a publication, tiffz comes from PATH" "$(cat "$sandbox/out")" \
	"tiffz=$bindir/tiffz"
assert_not_contains "the retired zig-out/bin is never used" "$(cat "$sandbox/out")" "zig-out/bin"

if [ "$failures" -eq 0 ]; then
	printf 'corruption-coverage contract passed\n'
	exit 0
fi
printf '%d failure(s)\n' "$failures" >&2
exit 1

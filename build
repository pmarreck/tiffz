#!/usr/bin/env bash
# Build tiffz via nix build (sandboxed, deterministic).
#
# Per CLAUDE.md, we don't use `nix develop -c zig build` for native
# macOS builds — Zig 0.15.2's bundled libSystem stubs don't always
# cover newer macOS versions, and the sandboxed Nix path avoids host
# OS detection issues entirely. Cross-compilation (e.g. -Dtarget=...)
# still works through `nix develop -c zig build` because Zig uses
# its own sysroot for non-native targets.
#
# Usage:
#   ./build              # ReleaseFast native build (default)
#   ./build --debug      # Debug build (loudly announces itself)
#   ./build --test       # Build the unit + CLI test binaries
#   ./build --help       # Show modes and dependency freshness controls

set -u

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT" || exit 1

mode="release"
for arg in "$@"; do
    case "$arg" in
        --debug) mode="debug" ;;
        --test)  mode="test" ;;
		-h|--help)
			cat <<'EOF'
Usage: ./build [--debug|--test]

  (default)  ReleaseFast build through nix build .#default
  --debug    Debug build through the Nix development shell
  --test     Build and run Zig unit and CLI tests
  -h, --help Show this help

Sibling dependency freshness:
  Before every build, pinned pmarreck dependencies must match the selected
  repository HEAD. GitHub HEAD is checked first. If GitHub is unavailable,
  an adjacent sibling checkout is used when present.

  .dependency-heads     Optional DEPENDENCY BRANCH overrides for repositories
                          whose package branch differs from symbolic HEAD.

  PREFER_LOCAL_FIRST=1  Check an adjacent sibling checkout before GitHub.
                          Accepted truthy values: 1, yes, true, on, y
                          (case-insensitive). This trusts the sibling's current
                          commit even when it is ahead of or behind GitHub.

  ALLOW_STALE=1         Continue after stale or unverifiable dependencies.
                          Diagnostics remain visible on stderr. Accepted truthy
                          values: 1, yes, true, on, y (case-insensitive).
EOF
			exit 0
			;;
        *) printf 'unknown arg: %s\n' "$arg" >&2; exit 2 ;;
    esac
done

"$ROOT/tools/check_dependency_freshness" \
	--manifest "$ROOT/build.zig.zon" \
	--repo-root "$ROOT" \
	--branch-map "$ROOT/.dependency-heads" || exit $?

case "$mode" in
    release)
        nix build .#default --print-out-paths
        # Mirror artifacts to the conventional zig-out/ path so other
        # tooling (and .envrc PATH_add) can find them.
        if [[ -L result ]]; then
            mkdir -p zig-out/bin zig-out/lib zig-out/include
            cp -fR result/bin/. zig-out/bin/ 2>/dev/null || true
            cp -fR result/lib/. zig-out/lib/ 2>/dev/null || true
            cp -fR result/include/. zig-out/include/ 2>/dev/null || true
            chmod -R u+w zig-out
        fi
        ;;
    debug)
        # Debug builds must announce themselves — see CLAUDE.md
        # "Debug builds of CLI tooling should loudly note that in
        # yellow to stderr". The Zig core checks comptime mode at
        # CLI startup; this build path just sets it.
        nix develop -c zig build -Doptimize=Debug
        ;;
    test)
        nix develop -c zig build test
        ;;
esac

#!/usr/bin/env bash
# Build tiffz for the current platform and publish bin/<PF>/tiffz.
#
# Layout (cross-platform-project-build-arch):
#   .nix-out/<PF>/[<VARIANT>/]<profile>   Nix output link (GC root), default
#   zig-out/<PF>/[<VARIANT>/]<profile>/   direct zig build install prefix
#   bin/<PF>/tiffz                        relative link to the last good build
# PF comes from tools/pf. Linux Nix builds target musl (static), direct
# devShell builds target the host glibc, so their VARIANTs differ.
#
# Publication happens only after the build succeeds and the product's own
# header (tools/inspect-binary) names this PF; the link is swapped by rename,
# so a failed or foreign build leaves the previous command in place.
#
# Native equivalent without this script, inside `nix develop`:
#   zig build --prefix zig-out/<PF>/[<VARIANT>/]ReleaseFast -Doptimize=ReleaseFast

set -u

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT" || exit 1

profile="ReleaseFast"
backend="nix"
action="build"
for arg in "$@"; do
	case "$arg" in
		--debug) profile="Debug" ;;
		--test) action="test"; backend="direct" ;;
		--backend=nix|--backend=direct) backend="${arg#--backend=}" ;;
		-h|--help)
			cat <<'EOF'
Usage: ./build [--debug] [--backend=nix|--backend=direct] [--test]

  (default)         ReleaseFast through `nix build .#default`, linked at
                    .nix-out/<PF>/[<VARIANT>/]ReleaseFast
  --debug           Debug profile (the binary announces DEBUG BUILD)
  --backend=nix     Sandboxed Nix package build (default)
  --backend=direct  `zig build` in the Nix devShell, installed under
                    zig-out/<PF>/[<VARIANT>/]<profile>
  --test            Run `zig build test` in the devShell; publishes nothing
  -h, --help        Show this help

A successful build whose header matches this platform is published as
bin/<PF>/tiffz (PF from tools/pf, e.g. linux-amd64).

Sibling dependency freshness:
  Before every build, pinned pmarreck dependencies must match the selected
  repository HEAD. GitHub HEAD is checked first. If GitHub is unavailable,
  an adjacent sibling checkout is used when present.

  .dependency-heads     Optional DEPENDENCY BRANCH overrides for repositories
                          whose package branch differs from symbolic HEAD.

  PREFER_LOCAL_FIRST=1  Check an adjacent sibling checkout before GitHub.
                          Accepted truthy values: 1, yes, true, on, y
                          (case-insensitive). This trusts the sibling's current
                          commit even when it is ahead of or behind GitHub.

  ALLOW_STALE=1         Continue after stale or unverifiable dependencies.
                          Diagnostics remain visible on stderr. Accepted truthy
                          values: 1, yes, true, on, y (case-insensitive).
EOF
			exit 0
			;;
		*) printf 'build: unknown argument: %s\n' "$arg" >&2; exit 2 ;;
	esac
done

PF="$("$ROOT/tools/pf")" || exit 2
case "$PF" in
	linux-*) nix_variant="musl/" direct_variant="gnu/" ;;
	*) nix_variant="" direct_variant="" ;;
esac

"$ROOT/tools/check_dependency_freshness" \
	--manifest "$ROOT/build.zig.zon" \
	--repo-root "$ROOT" \
	--branch-map "$ROOT/.dependency-heads" || exit $?

# publish PRODUCT_DIR: verify PRODUCT_DIR/bin/tiffz, then atomically point
# bin/<PF>/tiffz at it with a relative link.
publish() {
	local exe="$1/bin/tiffz" dir="bin/$PF" tmp
	if [ ! -f "$exe" ] || [ ! -x "$exe" ]; then
		printf 'build: no executable at %s; publication unchanged\n' "$exe" >&2
		return 1
	fi
	"$ROOT/tools/inspect-binary" --expect "$PF" "$exe" >/dev/null || {
		printf 'build: %s does not match %s; publication unchanged\n' "$exe" "$PF" >&2
		return 1
	}
	mkdir -p "$dir" || return 1
	tmp="$dir/.tiffz.publish.$$"
	ln -s "../../$exe" "$tmp" || return 1
	mv -f "$tmp" "$dir/tiffz" || { rm -f -- "$tmp"; return 1; }

	# LEGACY: the shared shell PATH still admits zig-out/bin and result/bin.
	# Keep both following the publication until that PATH cutover, then drop.
	mkdir -p zig-out/bin || return 1
	tmp="zig-out/bin/.tiffz.publish.$$"
	ln -s "../../$dir/tiffz" "$tmp" && mv -f "$tmp" zig-out/bin/tiffz
}

case "$action-$backend" in
	build-nix)
		attr="default"
		[ "$profile" = Debug ] && attr="debug"
		out_link=".nix-out/$PF/$nix_variant$profile"
		mkdir -p "$(dirname -- "$out_link")" || exit 1
		nix build ".#$attr" --print-out-paths --out-link "$out_link" || exit 1
		publish "$out_link" || exit 1
		ln -sfn "$out_link" result # LEGACY, see publish()
		;;
	build-direct)
		prefix="zig-out/$PF/$direct_variant$profile"
		nix develop -c zig build --prefix "$prefix" -Doptimize="$profile" || exit 1
		publish "$prefix" || exit 1
		;;
	test-direct)
		prefix="zig-out/$PF/$direct_variant$profile"
		nix develop -c zig build test --prefix "$prefix" -Doptimize="$profile" || exit 1
		;;
esac
